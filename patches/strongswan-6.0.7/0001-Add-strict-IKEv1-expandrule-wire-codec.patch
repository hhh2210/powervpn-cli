+{
+	tcase_add_test(tc, test_client_opaque_nul_is_not_string_semantics);
+	tcase_add_test(tc, test_len8_wire_limit_is_structural);
+	tcase_add_test(tc, test_vendor_profile_length_boundaries);
+	tcase_add_test(tc, test_revoke_zero_and_len255_are_structural);
+	tcase_add_test(tc, test_encode_rejects_payload_oversize);
+}
