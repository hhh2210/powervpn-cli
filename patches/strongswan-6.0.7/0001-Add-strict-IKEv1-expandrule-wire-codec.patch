+
+#include <library.h>
+
+typedef struct {
+	const char *id;
+	const char *hex;
+	size_t expected_length;
+	uint8_t *data;
+	size_t length;
+} expandrule_fixture_record_t;
+
+static uint8_t expandrule_v4_d0_bytes[] = {
+	0x00,0x00,0x00,0x1d,0xc0,0x00,0x02,0x0a,0x00,0x00,0x00,0x01,
+	0xc6,0x33,0x64,0x00,0xff,0xff,0xff,0x00,0x00,0x00,0x00,0x01,
