+	chunk_free(&encoded);
+	expandrule_message_destroy(message);
+}
+END_TEST
+
+START_TEST(test_len8_wire_limit_is_structural)
+{
+	uint8_t wire[272] = { 0 };
+	expandrule_message_t *message;
+	expandrule_error_t error;
+
+	wire[2] = 0x01;
+	wire[3] = 0x10;
+	wire[4] = 0xc0;
+	wire[6] = 0x02;
+	wire[7] = 0x0a;
+	wire[11] = 0x01;
+	wire[12] = 0xff;
+	memset(wire + 13, 0xa5, 255);
+	ck_assert(expandrule_codec_decode(EXPANDRULE_QM_ADD_SNAPSHOT,
+								  EXPANDRULE_DIALECT_1,
+								  chunk_from_thing(wire), &message, &error));
+	ck_assert_int_eq(message->data.client.primary[0].value.len, 255);
+	ck_assert(!expandrule_profile_validate(EXPANDRULE_QM_ADD_SNAPSHOT,
+									   message, &error));
+	ck_assert_int_eq(error.code, EXPANDRULE_ERROR_VALUE_LENGTH);
+	expandrule_message_destroy(message);
+}
+END_TEST
+
+START_TEST(test_vendor_profile_length_boundaries)
+{
+	uint8_t value[65];
+	expandrule_record_t record = { .value = chunk_create(value, 64) };
+	expandrule_message_t client = {
+		.kind = EXPANDRULE_CLIENT_ENVELOPE,
+		.data.client = {
+			.family = EXPANDRULE_IPV4,
+			.dialect = EXPANDRULE_DIALECT_0,
+			.leading_address = chunk_from_chars(0xc0,0x00,0x02,0x0a),
+			.secondary_count = 1,
+			.secondary = &record,
+		},
+	};
+	expandrule_message_t revoke = {
+		.kind = EXPANDRULE_SERVER_REVOKE,
+		.data.revoke = { .opaque_value = chunk_create(value, 63) },
+	};
+	expandrule_error_t error;
+
+	memset(value, 0xa5, sizeof(value));
+	ck_assert(expandrule_profile_validate(EXPANDRULE_INFO_ADD_DELTA,
+									  &client, &error));
+	record.value.len = 65;
+	ck_assert(!expandrule_profile_validate(EXPANDRULE_INFO_ADD_DELTA,
+									   &client, &error));
+	ck_assert_int_eq(error.code, EXPANDRULE_ERROR_VALUE_LENGTH);
+
+	client.data.client.dialect = EXPANDRULE_DIALECT_1;
+	record.value.len = 16;
+	ck_assert(expandrule_profile_validate(EXPANDRULE_INFO_ADD_DELTA,
+									  &client, &error));
+	record.value.len = 17;
+	ck_assert(!expandrule_profile_validate(EXPANDRULE_INFO_ADD_DELTA,
+									   &client, &error));
+
+	ck_assert(expandrule_profile_validate(EXPANDRULE_INFO_REVOKE_V1,
+									  &revoke, &error));
+	revoke.data.revoke.opaque_value.len = 64;
+	ck_assert(!expandrule_profile_validate(EXPANDRULE_INFO_REVOKE_V1,
+									   &revoke, &error));
+	revoke.data.revoke.opaque_value = chunk_empty;
+	ck_assert(!expandrule_profile_validate(EXPANDRULE_INFO_REVOKE_V1,
+									   &revoke, &error));
+}
+END_TEST
+
+START_TEST(test_revoke_zero_and_len255_are_structural)
+{
+	uint8_t empty[] = { 0x00,0x00,0x00,0x05,0x00 };
+	uint8_t maximum[260] = { 0 };
+	expandrule_message_t *message;
+	expandrule_error_t error;
+
+	ck_assert(expandrule_codec_decode(EXPANDRULE_INFO_REVOKE_V1,
+								  EXPANDRULE_DIALECT_NONE,
+								  chunk_from_thing(empty), &message, &error));
+	ck_assert_int_eq(message->data.revoke.opaque_value.len, 0);
+	ck_assert(!expandrule_profile_validate(EXPANDRULE_INFO_REVOKE_V1,
+									   message, &error));
+	expandrule_message_destroy(message);
+
+	maximum[2] = 0x01;
+	maximum[3] = 0x04;
+	maximum[4] = 0xff;
+	memset(maximum + 5, 0xa5, 255);
+	ck_assert(expandrule_codec_decode(EXPANDRULE_INFO_REVOKE_V1,
+								  EXPANDRULE_DIALECT_NONE,
+								  chunk_from_thing(maximum), &message, &error));
+	ck_assert_int_eq(message->data.revoke.opaque_value.len, 255);
+	ck_assert(!expandrule_profile_validate(EXPANDRULE_INFO_REVOKE_V1,
+									   message, &error));
+	expandrule_message_destroy(message);
+}
+END_TEST
