diff --git a/src/libcharon/encoding/payloads/expandrule_client_codec.c b/src/libcharon/encoding/payloads/expandrule_client_codec.c
new file mode 100644
index 0000000..e5e6bc4
--- /dev/null
+++ b/src/libcharon/encoding/payloads/expandrule_client_codec.c
@@ -0,0 +1,258 @@
+/*
+ * Copyright (C) 2026 Zhuoyuan Hao
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation; either version 2 of the License, or (at your
+ * option) any later version.  See <http://www.fsf.org/copyleft/gpl.txt>.
+ */
+
+#include "expandrule_codec_internal.h"
+
+#include <bio/bio_reader.h>
+
+static size_t current_offset(bio_reader_t *reader, size_t body_length,
+							 size_t body_offset)
+{
+	return body_offset + body_length - reader->remaining(reader);
+}
+
+static bool mask_to_prefix(uint32_t mask, uint8_t *prefix)
+{
+	bool saw_zero = FALSE;
+	uint8_t bits = 0;
+	int i;
+
+	for (i = 31; i >= 0; i--)
+	{
+		if (mask & (1U << i))
+		{
+			if (saw_zero)
+			{
+				return FALSE;
+			}
+			bits++;
+		}
+		else
+		{
+			saw_zero = TRUE;
+		}
+	}
+	*prefix = bits;
+	return TRUE;
+}
+
+static bool clone_record(expandrule_record_t *record, chunk_t value,
+						 uint8_t prefix, expandrule_error_t *error,
+						 size_t offset)
+{
+	record->value = chunk_clone(value);
+	if (value.len && !record->value.ptr)
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_OUT_OF_MEMORY, offset);
+	}
+	record->prefix_length = prefix;
+	return TRUE;
+}
+
+static bool read_address_record(bio_reader_t *reader,
+								expandrule_family_t family,
+								expandrule_record_t *records, size_t index,
+								size_t body_length, size_t body_offset,
+								expandrule_error_t *error)
+{
+	size_t offset = current_offset(reader, body_length, body_offset);
+	uint32_t mask_or_prefix;
+	uint8_t prefix;
+	chunk_t address;
+
+	if (!reader->read_data(reader, expandrule_family_size(family), &address) ||
+		!reader->read_uint32(reader, &mask_or_prefix))
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_TRUNCATED, offset);
+	}
+	if (family == EXPANDRULE_IPV4)
+	{
+		if (!mask_to_prefix(mask_or_prefix, &prefix))
+		{
+			return expandrule_fail(error, EXPANDRULE_ERROR_INVALID_MASK,
+								offset + 4);
+		}
+	}
+	else
+	{
+		if (mask_or_prefix > 128)
+		{
+			return expandrule_fail(error, EXPANDRULE_ERROR_INVALID_PREFIX,
+								offset + 16);
+		}
+		prefix = mask_or_prefix;
+	}
+	return clone_record(&records[index], address, prefix, error, offset);
+}
+
+static bool read_opaque_record(bio_reader_t *reader,
+							   expandrule_record_t *records, size_t index,
+							   size_t body_length, size_t body_offset,
+							   expandrule_error_t *error)
+{
+	size_t offset = current_offset(reader, body_length, body_offset);
+	chunk_t value;
+
+	if (!reader->read_data8(reader, &value))
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_TRUNCATED, offset);
+	}
+	return clone_record(&records[index], value, 0, error, offset);
+}
+
+static bool allocate_records(uint32_t count, expandrule_record_t **records,
+							 size_t offset,
+							 expandrule_error_t *error)
+{
+	if (count > EXPANDRULE_MAX_RECORDS)
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_COUNT_LIMIT, offset);
+	}
+	if (!count)
+	{
+		*records = NULL;
+		return TRUE;
+	}
+	*records = calloc(count, sizeof(**records));
+	if (!*records)
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_OUT_OF_MEMORY, offset);
+	}
+	return TRUE;
+}
+
+static bool read_count(bio_reader_t *reader, uint32_t *count,
+					   size_t minimum_record_size, size_t tail_reserve,
+					   size_t body_length,
+					   size_t body_offset, expandrule_error_t *error)
+{
+	size_t offset = current_offset(reader, body_length, body_offset), remaining;
+
+	if (!reader->read_uint32(reader, count))
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_TRUNCATED, offset);
+	}
+	if (*count > EXPANDRULE_MAX_RECORDS)
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_COUNT_LIMIT, offset);
+	}
+	remaining = reader->remaining(reader);
+	if (remaining < tail_reserve ||
+		(minimum_record_size &&
+		 *count > (remaining - tail_reserve) / minimum_record_size))
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_TRUNCATED, offset);
+	}
+	return TRUE;
+}
+
+bool expandrule_client_decode(expandrule_family_t family,
+							  expandrule_dialect_t dialect, chunk_t body,
+							  size_t body_offset,
+							  expandrule_message_t **message,
+							  expandrule_error_t *error)
+{
+	expandrule_message_t *decoded;
+	bio_reader_t *reader;
+	size_t address_size, primary_minimum, i, offset;
+	uint32_t count;
+	chunk_t leading_address;
+	bool success = FALSE;
+
+	address_size = expandrule_family_size(family);
+	primary_minimum = dialect == EXPANDRULE_DIALECT_0 ?
+					  address_size + 4 : 1;
+	reader = bio_reader_create(body);
+	decoded = calloc(1, sizeof(*decoded));
+	if (!decoded)
+	{
+		expandrule_fail(error, EXPANDRULE_ERROR_OUT_OF_MEMORY, body_offset);
+		reader->destroy(reader);
+		return FALSE;
+	}
+	decoded->kind = EXPANDRULE_CLIENT_ENVELOPE;
+	decoded->data.client.family = family;
+	decoded->data.client.dialect = dialect;
+
+	if (!reader->read_data(reader, address_size, &leading_address))
+	{
+		expandrule_fail(error, EXPANDRULE_ERROR_TRUNCATED, body_offset);
+		goto done;
+	}
+	decoded->data.client.leading_address = chunk_clone(leading_address);
+	if (!decoded->data.client.leading_address.ptr)
+	{
+		expandrule_fail(error, EXPANDRULE_ERROR_OUT_OF_MEMORY, body_offset);
+		goto done;
+	}
+
+	if (!read_count(reader, &count, primary_minimum, 4, body.len, body_offset,
+					error))
+	{
+		goto done;
+	}
+	offset = current_offset(reader, body.len, body_offset) - 4;
+	if (!allocate_records(count, &decoded->data.client.primary, offset, error))
+	{
+		goto done;
+	}
+	decoded->data.client.primary_count = count;
+	for (i = 0; i < count; i++)
+	{
+		if (dialect == EXPANDRULE_DIALECT_0)
+		{
+			if (!read_address_record(reader, family,
+								 decoded->data.client.primary, i, body.len,
+								 body_offset, error))
+			{
+				goto done;
+			}
+		}
+		else if (!read_opaque_record(reader, decoded->data.client.primary, i,
+									body.len, body_offset, error))
+		{
+			goto done;
+		}
+	}
+
+	if (!read_count(reader, &count, 1, 0, body.len, body_offset, error))
+	{
+		goto done;
+	}
+	offset = current_offset(reader, body.len, body_offset) - 4;
+	if (!allocate_records(count, &decoded->data.client.secondary, offset, error))
+	{
+		goto done;
+	}
+	decoded->data.client.secondary_count = count;
+	for (i = 0; i < count; i++)
+	{
+		if (!read_opaque_record(reader, decoded->data.client.secondary, i,
+								body.len, body_offset, error))
+		{
+			goto done;
+		}
+	}
+	if (reader->remaining(reader))
+	{
+		expandrule_fail(error, EXPANDRULE_ERROR_TRAILING_DATA,
+						current_offset(reader, body.len, body_offset));
+		goto done;
+	}
+	success = TRUE;
+	*message = decoded;
+
+done:
+	reader->destroy(reader);
+	if (!success)
+	{
+		expandrule_message_destroy(decoded);
+	}
+	return success;
+}
diff --git a/src/libcharon/encoding/payloads/expandrule_client_encode.c b/src/libcharon/encoding/payloads/expandrule_client_encode.c
new file mode 100644
index 0000000..c0dceba
--- /dev/null
+++ b/src/libcharon/encoding/payloads/expandrule_client_encode.c
@@ -0,0 +1,92 @@
+/*
+ * Copyright (C) 2026 Zhuoyuan Hao
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation; either version 2 of the License, or (at your
+ * option) any later version.  See <http://www.fsf.org/copyleft/gpl.txt>.
+ */
+
+#include "expandrule_codec_internal.h"
+
+#include <bio/bio_writer.h>
+
+static bool checked_add(size_t *length, size_t amount,
+						expandrule_error_t *error)
+{
+	if (amount > UINT16_MAX - 4 - *length)
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_OVERSIZE, 4);
+	}
+	*length += amount;
+	return TRUE;
+}
+
+static uint32_t prefix_to_mask(uint8_t prefix)
+{
+	if (!prefix)
+	{
+		return 0;
+	}
+	return UINT32_MAX << (32 - prefix);
+}
+
+bool expandrule_client_encode(const expandrule_client_envelope_t *client,
+							  chunk_t *body, expandrule_error_t *error)
+{
+	bio_writer_t *writer;
+	size_t body_length, address_size, record_length, i;
+
+	address_size = expandrule_family_size(client->family);
+	body_length = address_size + 8;
+	for (i = 0; i < client->primary_count; i++)
+	{
+		record_length = client->dialect == EXPANDRULE_DIALECT_0 ?
+						address_size + 4 : 1 + client->primary[i].value.len;
+		if (!checked_add(&body_length, record_length, error))
+		{
+			return FALSE;
+		}
+	}
+	for (i = 0; i < client->secondary_count; i++)
+	{
+		if (!checked_add(&body_length, 1 + client->secondary[i].value.len,
+						 error))
+		{
+			return FALSE;
+		}
+	}
+
+	writer = bio_writer_create(body_length);
+	writer->write_data(writer, client->leading_address);
+	writer->write_uint32(writer, client->primary_count);
+	for (i = 0; i < client->primary_count; i++)
+	{
+		if (client->dialect == EXPANDRULE_DIALECT_0)
+		{
+			writer->write_data(writer, client->primary[i].value);
+			if (client->family == EXPANDRULE_IPV4)
+			{
+				writer->write_uint32(writer,
+								 prefix_to_mask(client->primary[i].prefix_length));
+			}
+			else
+			{
+				writer->write_uint32(writer,
+								 client->primary[i].prefix_length);
+			}
+		}
+		else
+		{
+			writer->write_data8(writer, client->primary[i].value);
+		}
+	}
+	writer->write_uint32(writer, client->secondary_count);
+	for (i = 0; i < client->secondary_count; i++)
+	{
+		writer->write_data8(writer, client->secondary[i].value);
+	}
+	*body = writer->extract_buf(writer);
+	writer->destroy(writer);
+	return TRUE;
+}
diff --git a/src/libcharon/encoding/payloads/expandrule_codec.c b/src/libcharon/encoding/payloads/expandrule_codec.c
new file mode 100644
index 0000000..ac86f15
--- /dev/null
+++ b/src/libcharon/encoding/payloads/expandrule_codec.c
@@ -0,0 +1,187 @@
+/*
+ * Copyright (C) 2026 Zhuoyuan Hao
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation; either version 2 of the License, or (at your
+ * option) any later version.  See <http://www.fsf.org/copyleft/gpl.txt>.
+ *
+ * This program is distributed in the hope that it will be useful, but
+ * WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY
+ * or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+ * for more details.
+ */
+
+#include "expandrule_codec_internal.h"
+
+#include <bio/bio_reader.h>
+#include <bio/bio_writer.h>
+
+bool expandrule_codec_decode(expandrule_wire_form_t form,
+							 expandrule_dialect_t dialect, chunk_t payload,
+							 expandrule_message_t **message,
+							 expandrule_error_t *error)
+{
+	bio_reader_t *reader;
+	expandrule_family_t family;
+	uint8_t next, flags;
+	uint16_t length;
+	chunk_t body;
+	bool success;
+
+	expandrule_clear_error(error);
+	if (message)
+	{
+		*message = NULL;
+	}
+	if (!message || (!payload.ptr && payload.len))
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_INVALID_ARGUMENT, 0);
+	}
+	if ((!expandrule_form_is_client(form) && !expandrule_form_is_revoke(form)) ||
+		(expandrule_form_is_client(form) &&
+		 dialect != EXPANDRULE_DIALECT_0 &&
+		 dialect != EXPANDRULE_DIALECT_1) ||
+		(expandrule_form_is_revoke(form) && dialect != EXPANDRULE_DIALECT_NONE))
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_UNSUPPORTED_CONTEXT, 0);
+	}
+	if (payload.len > UINT16_MAX)
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_OVERSIZE, 0);
+	}
+
+	reader = bio_reader_create(payload);
+	if (!reader->read_uint8(reader, &next) ||
+		!reader->read_uint8(reader, &flags) ||
+		!reader->read_uint16(reader, &length))
+	{
+		expandrule_fail(error, EXPANDRULE_ERROR_TRUNCATED, 0);
+		reader->destroy(reader);
+		return FALSE;
+	}
+	if (length != payload.len || length < 4)
+	{
+		expandrule_fail(error, EXPANDRULE_ERROR_INVALID_LENGTH, 2);
+		reader->destroy(reader);
+		return FALSE;
+	}
+	body = reader->peek(reader);
+	if (expandrule_form_is_client(form))
+	{
+		if (flags == 0)
+		{
+			family = EXPANDRULE_IPV4;
+		}
+		else if (flags == 6)
+		{
+			family = EXPANDRULE_IPV6;
+		}
+		else
+		{
+			expandrule_fail(error, EXPANDRULE_ERROR_INVALID_FLAGS, 1);
+			reader->destroy(reader);
+			return FALSE;
+		}
+		success = expandrule_client_decode(family, dialect, body, 4,
+										   message, error);
+	}
+	else
+	{
+		success = expandrule_revoke_decode(flags, body, 4, message, error);
+	}
+	reader->destroy(reader);
+	if (success)
+	{
+		(*message)->next_payload = next;
+	}
+	return success;
+}
+
+bool expandrule_codec_encode(expandrule_wire_form_t form,
+							 const expandrule_message_t *message,
+							 chunk_t *payload, expandrule_error_t *error)
+{
+	bio_writer_t *writer;
+	chunk_t body = chunk_empty;
+	uint8_t flags;
+
+	expandrule_clear_error(error);
+	if (payload)
+	{
+		*payload = chunk_empty;
+	}
+	if (!message || !payload)
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_INVALID_ARGUMENT, 0);
+	}
+	if (form == EXPANDRULE_INFO_REVOKE_LEGACY ||
+		!expandrule_profile_validate(form, message, error))
+	{
+		if (form == EXPANDRULE_INFO_REVOKE_LEGACY &&
+			(!error || error->code == EXPANDRULE_ERROR_NONE))
+		{
+			expandrule_fail(error, EXPANDRULE_ERROR_UNSUPPORTED_CONTEXT, 0);
+		}
+		return FALSE;
+	}
+	if (expandrule_form_is_client(form))
+	{
+		if (!expandrule_client_encode(&message->data.client, &body, error))
+		{
+			return FALSE;
+		}
+		flags = message->data.client.family == EXPANDRULE_IPV6 ? 6 : 0;
+	}
+	else
+	{
+		if (!expandrule_revoke_encode(&message->data.revoke, &body, error))
+		{
+			return FALSE;
+		}
+		flags = message->data.revoke.raw_flags;
+	}
+	if (body.len > UINT16_MAX - 4)
+	{
+		chunk_free(&body);
+		return expandrule_fail(error, EXPANDRULE_ERROR_OVERSIZE, 4);
+	}
+	writer = bio_writer_create(body.len + 4);
+	writer->write_uint8(writer, 0);
+	writer->write_uint8(writer, flags);
+	writer->write_uint16(writer, body.len + 4);
+	writer->write_data(writer, body);
+	*payload = writer->extract_buf(writer);
+	writer->destroy(writer);
+	chunk_free(&body);
+	return TRUE;
+}
+
+void expandrule_message_destroy(expandrule_message_t *message)
+{
+	size_t i;
+
+	if (!message)
+	{
+		return;
+	}
+	if (message->kind == EXPANDRULE_CLIENT_ENVELOPE)
+	{
+		chunk_free(&message->data.client.leading_address);
+		for (i = 0; i < message->data.client.primary_count; i++)
+		{
+			chunk_free(&message->data.client.primary[i].value);
+		}
+		for (i = 0; i < message->data.client.secondary_count; i++)
+		{
+			chunk_free(&message->data.client.secondary[i].value);
+		}
+		free(message->data.client.primary);
+		free(message->data.client.secondary);
+	}
+	else if (message->kind == EXPANDRULE_SERVER_REVOKE)
+	{
+		chunk_free(&message->data.revoke.opaque_value);
+	}
+	free(message);
+}
