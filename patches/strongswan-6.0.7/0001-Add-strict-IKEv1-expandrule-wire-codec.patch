+
+#include "test_suite.h"
+#include "expandrule_test_fixtures.h"
+
+#include <encoding/payloads/expandrule_codec.h>
+
+static uint8_t single_v4[] = {
+	0x00,0x00,0x00,0x18,0xc0,0x00,0x02,0x0a,0x00,0x00,0x00,0x01,
+	0xc6,0x33,0x64,0x00,0xff,0xff,0xff,0x00,0x00,0x00,0x00,0x00,
+};
+
+static uint8_t single_v6[] = {
+	0x00,0x06,0x00,0x30,0x20,0x01,0x0d,0xb8,0x00,0x00,0x00,0x00,
+	0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x10,0x00,0x00,0x00,0x01,
+	0x20,0x01,0x0d,0xb8,0x00,0x01,0x00,0x00,0x00,0x00,0x00,0x00,
+	0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x40,0x00,0x00,0x00,0x00,
+};
+
+START_TEST(test_fixture_manifest_matches_compiled_bytes)
+{
+	chunk_t hex;
+	size_t i;
+
+	ck_assert_int_eq(countof(expandrule_fixture_records), 7);
+	for (i = 0; i < countof(expandrule_fixture_records); i++)
+	{
+		expandrule_fixture_record_t *fixture = &expandrule_fixture_records[i];
+
+		ck_assert(fixture->id[0] != '\0');
+		ck_assert_int_eq(fixture->expected_length, fixture->length);
+		hex = chunk_to_hex(chunk_create(fixture->data, fixture->length),
+						   NULL, FALSE);
+		ck_assert(chunk_equals(hex,
+						   chunk_create((uint8_t*)fixture->hex,
+										strlen(fixture->hex))));
+		chunk_free(&hex);
+	}
+}
+END_TEST
+
+START_TEST(test_all_form_mappings)
+{
+	struct {
+		expandrule_wire_form_t form;
+		uint8_t payload_type;
+		expandrule_direction_t direction;
+	} mappings[] = {
+		{ EXPANDRULE_QM_ADD_SNAPSHOT, 18, EXPANDRULE_CLIENT_TO_SERVER },
+		{ EXPANDRULE_INFO_ADD_DELTA, 18, EXPANDRULE_CLIENT_TO_SERVER },
+		{ EXPANDRULE_INFO_DELETE_DELTA, 19, EXPANDRULE_CLIENT_TO_SERVER },
+		{ EXPANDRULE_INFO_REVOKE_V1, 19, EXPANDRULE_SERVER_TO_CLIENT },
+		{ EXPANDRULE_INFO_REVOKE_LEGACY, 17, EXPANDRULE_SERVER_TO_CLIENT },
+	};
+	size_t i;
+
+	for (i = 0; i < countof(mappings); i++)
+	{
+		ck_assert_int_eq(expandrule_form_payload_type(mappings[i].form),
+						 mappings[i].payload_type);
+		ck_assert_int_eq(expandrule_form_direction(mappings[i].form),
+						 mappings[i].direction);
+	}
+}
+END_TEST
+
+START_TEST(test_failure_outputs_and_unknown_context)
+{
+	uint8_t empty[] = {
+		0x00,0x00,0x00,0x10,0xc0,0x00,0x02,0x0a,
+		0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
+	};
+	expandrule_message_t *message = (void*)1;
+	expandrule_error_t error;
+	chunk_t invalid = { .ptr = NULL, .len = 1 };
+	chunk_t output = chunk_from_chars(0xaa);
+
+	ck_assert(!expandrule_codec_decode(EXPANDRULE_QM_ADD_SNAPSHOT,
+								  EXPANDRULE_DIALECT_0, invalid, &message,
+								  &error));
+	ck_assert(message == NULL);
+	ck_assert_int_eq(error.code, EXPANDRULE_ERROR_INVALID_ARGUMENT);
+
+	ck_assert(!expandrule_codec_encode(EXPANDRULE_QM_ADD_SNAPSHOT, NULL,
+								  &output, &error));
+	ck_assert(output.ptr == NULL);
+	ck_assert_int_eq(output.len, 0);
+
+	ck_assert(!expandrule_codec_decode(EXPANDRULE_QM_ADD_SNAPSHOT,
+								  (expandrule_dialect_t)99,
+								  chunk_from_thing(empty), &message, &error));
+	ck_assert_int_eq(error.code, EXPANDRULE_ERROR_UNSUPPORTED_CONTEXT);
+	ck_assert_int_eq(expandrule_form_payload_type((expandrule_wire_form_t)99), 0);
+	ck_assert_int_eq(expandrule_form_direction((expandrule_wire_form_t)99),
+						 EXPANDRULE_DIRECTION_UNKNOWN);
+}
+END_TEST
+
+START_TEST(test_primary_count_reserves_secondary_count)
+{
+	uint8_t missing_tail[] = {
+		0x00,0x00,0x00,0x14,0xc0,0x00,0x02,0x0a,0x00,0x00,0x00,0x01,
+		0xc6,0x33,0x64,0x00,0xff,0xff,0xff,0x00,
+	};
+	expandrule_message_t *message;
+	expandrule_error_t error;
+
+	ck_assert(!expandrule_codec_decode(EXPANDRULE_QM_ADD_SNAPSHOT,
+								  EXPANDRULE_DIALECT_0,
+								  chunk_from_thing(missing_tail), &message,
+								  &error));
+	ck_assert(message == NULL);
+	ck_assert_int_eq(error.code, EXPANDRULE_ERROR_TRUNCATED);
+	ck_assert_int_eq(error.offset, 8);
+}
+END_TEST
+
+START_TEST(test_ipv4_mask_boundaries)
+{
+	struct {
+		uint8_t bytes[4];
+		uint8_t prefix;
+	} valid[] = {
+		{ { 0x00,0x00,0x00,0x00 }, 0 },
+		{ { 0x80,0x00,0x00,0x00 }, 1 },
+		{ { 0xff,0xff,0xff,0x00 }, 24 },
+		{ { 0xff,0xff,0xff,0xff }, 32 },
+	};
+	uint8_t invalid[][4] = {
+		{ 0xff,0x00,0xff,0x00 },
+		{ 0x7f,0xff,0xff,0xff },
+		{ 0xff,0xff,0xff,0x01 },
+	};
+	uint8_t wire[sizeof(single_v4)];
+	expandrule_message_t *message;
+	expandrule_error_t error;
+	size_t i;
+
+	for (i = 0; i < countof(valid); i++)
+	{
+		memcpy(wire, single_v4, sizeof(wire));
+		memcpy(wire + 16, valid[i].bytes, sizeof(valid[i].bytes));
+		ck_assert(expandrule_codec_decode(EXPANDRULE_INFO_ADD_DELTA,
+									  EXPANDRULE_DIALECT_0,
+									  chunk_from_thing(wire), &message, &error));
+		ck_assert_int_eq(message->data.client.primary[0].prefix_length,
+						 valid[i].prefix);
+		ck_assert(expandrule_profile_validate(EXPANDRULE_INFO_ADD_DELTA,
+									message, &error));
+		expandrule_message_destroy(message);
+	}
+	for (i = 0; i < countof(invalid); i++)
+	{
+		memcpy(wire, single_v4, sizeof(wire));
+		memcpy(wire + 16, invalid[i], sizeof(invalid[i]));
+		ck_assert(!expandrule_codec_decode(EXPANDRULE_INFO_ADD_DELTA,
+									   EXPANDRULE_DIALECT_0,
+									   chunk_from_thing(wire), &message, &error));
+		ck_assert_int_eq(error.code, EXPANDRULE_ERROR_INVALID_MASK);
+	}
+}
+END_TEST
+
+START_TEST(test_ipv6_prefix_boundaries)
+{
+	uint8_t prefixes[] = { 0, 128 };
+	uint8_t wire[sizeof(single_v6)];
+	expandrule_message_t *message;
+	expandrule_error_t error;
+	size_t i;
+
+	for (i = 0; i < countof(prefixes); i++)
+	{
+		memcpy(wire, single_v6, sizeof(wire));
+		memset(wire + 40, 0, 4);
+		wire[43] = prefixes[i];
+		ck_assert(expandrule_codec_decode(EXPANDRULE_QM_ADD_SNAPSHOT,
+									  EXPANDRULE_DIALECT_0,
+									  chunk_from_thing(wire), &message, &error));
+		ck_assert_int_eq(message->data.client.primary[0].prefix_length,
+						 prefixes[i]);
+		ck_assert(expandrule_profile_validate(EXPANDRULE_QM_ADD_SNAPSHOT,
+									message, &error));
+		expandrule_message_destroy(message);
+	}
+}
+END_TEST
+
+START_TEST(test_duplicate_scope_preserves_wire_identity)
+{
+	chunk_t same = chunk_from_chars(0xa1,0xb2);
+	expandrule_record_t primary_d1[] = { { .value = same } };
+	expandrule_record_t secondary_d1[] = { { .value = same } };
+	expandrule_record_t primary_d0[] = {
+		{ .value = chunk_from_chars(0xc6,0x33,0x64,0x01), .prefix_length = 24 },
+		{ .value = chunk_from_chars(0xc6,0x33,0x64,0x02), .prefix_length = 24 },
+	};
+	expandrule_message_t message = {
+		.kind = EXPANDRULE_CLIENT_ENVELOPE,
+		.data.client = {
+			.family = EXPANDRULE_IPV4,
+			.dialect = EXPANDRULE_DIALECT_1,
+			.leading_address = chunk_from_chars(0xc0,0x00,0x02,0x0a),
+			.primary_count = 1,
+			.primary = primary_d1,
+			.secondary_count = 1,
+			.secondary = secondary_d1,
+		},
+	};
+	expandrule_error_t error;
+
+	ck_assert(expandrule_profile_validate(EXPANDRULE_QM_ADD_SNAPSHOT,
+									  &message, &error));
+	message.data.client.dialect = EXPANDRULE_DIALECT_0;
+	message.data.client.primary_count = countof(primary_d0);
+	message.data.client.primary = primary_d0;
+	message.data.client.secondary_count = 0;
+	message.data.client.secondary = NULL;
+	ck_assert(expandrule_profile_validate(EXPANDRULE_QM_ADD_SNAPSHOT,
+									  &message, &error));
+}
+END_TEST
+
+void expandrule_add_boundary_tests(TCase *tc)
+{
+	tcase_add_test(tc, test_fixture_manifest_matches_compiled_bytes);
+	tcase_add_test(tc, test_all_form_mappings);
+	tcase_add_test(tc, test_failure_outputs_and_unknown_context);
+	tcase_add_test(tc, test_primary_count_reserves_secondary_count);
+	tcase_add_test(tc, test_ipv4_mask_boundaries);
+	tcase_add_test(tc, test_ipv6_prefix_boundaries);
+	tcase_add_test(tc, test_duplicate_scope_preserves_wire_identity);
+}
