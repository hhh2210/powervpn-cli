+START_TEST(test_encode_rejects_payload_oversize)
+{
+	const size_t count = 1010, width = 64;
+	expandrule_record_t *records = calloc(count, sizeof(*records));
+	uint8_t *values = calloc(count, width);
+	expandrule_message_t message = {
+		.kind = EXPANDRULE_CLIENT_ENVELOPE,
+		.data.client = {
+			.family = EXPANDRULE_IPV4,
+			.dialect = EXPANDRULE_DIALECT_0,
+			.leading_address = chunk_from_chars(0xc0,0x00,0x02,0x0a),
+			.secondary_count = count,
+			.secondary = records,
+		},
+	};
+	expandrule_error_t error;
+	chunk_t output = chunk_empty;
+	size_t i;
+
+	ck_assert(records != NULL);
+	ck_assert(values != NULL);
+	for (i = 0; i < count; i++)
+	{
+		memset(values + i * width, 0xa5, width);
+		values[i * width] = i >> 8;
+		values[i * width + 1] = i;
+		records[i].value = chunk_create(values + i * width, width);
+	}
+	ck_assert(!expandrule_codec_encode(EXPANDRULE_QM_ADD_SNAPSHOT, &message,
+								   &output, &error));
+	ck_assert_int_eq(error.code, EXPANDRULE_ERROR_OVERSIZE);
+	ck_assert(output.ptr == NULL);
+	free(values);
+	free(records);
+}
+END_TEST
