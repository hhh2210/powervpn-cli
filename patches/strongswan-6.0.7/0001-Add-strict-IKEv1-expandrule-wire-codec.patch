+
+static expandrule_fixture_record_t expandrule_fixture_records[] = {
+	{ "v4-dialect0-quick-snapshot", "0000001dc000020a00000001c6336400ffffff000000000104deadbeef", 29, expandrule_v4_d0_bytes, sizeof(expandrule_v4_d0_bytes) },
+	{ "v6-dialect0-quick-snapshot", "0006003020010db80000000000000000000000100000000120010db80001000000000000000000000000004000000000", 48, expandrule_v6_d0_bytes, sizeof(expandrule_v6_d0_bytes) },
+	{ "v4-dialect1-quick-snapshot", "0000001ac000020a000000010401020304000000010405060708", 26, expandrule_v4_d1_bytes, sizeof(expandrule_v4_d1_bytes) },
+	{ "v4-empty-quick-snapshot", "00000010c000020a0000000000000000", 16, expandrule_empty_v4_bytes, sizeof(expandrule_empty_v4_bytes) },
