+
+#ifndef EXPANDRULE_CODEC_INTERNAL_H_
+#define EXPANDRULE_CODEC_INTERNAL_H_
+
+#include "expandrule_codec.h"
+
+bool expandrule_fail(expandrule_error_t *error,
+					 expandrule_error_code_t code, size_t offset);
+
+void expandrule_clear_error(expandrule_error_t *error);
+
+size_t expandrule_family_size(expandrule_family_t family);
+
+bool expandrule_record_duplicate(const expandrule_record_t *records, size_t count,
+								 chunk_t value, uint8_t prefix,
+								 bool use_prefix);
+
+bool expandrule_chunk_has_nul(chunk_t value);
+
+bool expandrule_form_is_client(expandrule_wire_form_t form);
+
+bool expandrule_form_is_revoke(expandrule_wire_form_t form);
+
+bool expandrule_client_decode(expandrule_family_t family,
+							  expandrule_dialect_t dialect, chunk_t body,
+							  size_t body_offset,
+							  expandrule_message_t **message,
+							  expandrule_error_t *error);
+
+bool expandrule_client_encode(const expandrule_client_envelope_t *client,
+							  chunk_t *body, expandrule_error_t *error);
+
+bool expandrule_revoke_decode(uint8_t raw_flags, chunk_t body,
+							  size_t body_offset,
+							  expandrule_message_t **message,
+							  expandrule_error_t *error);
+
+bool expandrule_revoke_encode(const expandrule_server_revoke_t *revoke,
+							  chunk_t *body, expandrule_error_t *error);
+
+#endif /* EXPANDRULE_CODEC_INTERNAL_H_ */
diff --git a/src/libcharon/encoding/payloads/expandrule_codec_support.c b/src/libcharon/encoding/payloads/expandrule_codec_support.c
new file mode 100644
index 0000000..6e12fec
--- /dev/null
+++ b/src/libcharon/encoding/payloads/expandrule_codec_support.c
@@ -0,0 +1,133 @@
+/*
+ * Copyright (C) 2026 Zhuoyuan Hao
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation; either version 2 of the License, or (at your
+ * option) any later version.  See <http://www.fsf.org/copyleft/gpl.txt>.
+ */
+
+#include "expandrule_codec_internal.h"
+
+#include <string.h>
+
+bool expandrule_fail(expandrule_error_t *error,
+					 expandrule_error_code_t code, size_t offset)
+{
+	if (error)
+	{
+		*error = (expandrule_error_t){
+			.code = code,
+			.offset = offset,
+		};
+	}
+	return FALSE;
+}
+
+void expandrule_clear_error(expandrule_error_t *error)
+{
+	if (error)
+	{
+		*error = (expandrule_error_t){ .code = EXPANDRULE_ERROR_NONE };
+	}
+}
+
+size_t expandrule_family_size(expandrule_family_t family)
+{
+	switch (family)
+	{
+		case EXPANDRULE_IPV4:
+			return 4;
+		case EXPANDRULE_IPV6:
+			return 16;
+	}
+	return 0;
+}
+
+bool expandrule_record_duplicate(const expandrule_record_t *records, size_t count,
+								 chunk_t value, uint8_t prefix,
+								 bool use_prefix)
+{
+	size_t i;
+
+	for (i = 0; i < count; i++)
+	{
+		if (chunk_equals(records[i].value, value) &&
+			(!use_prefix || records[i].prefix_length == prefix))
+		{
+			return TRUE;
+		}
+	}
+	return FALSE;
+}
+
+bool expandrule_chunk_has_nul(chunk_t value)
+{
+	return value.len && memchr(value.ptr, '\0', value.len);
+}
+
+bool expandrule_form_is_client(expandrule_wire_form_t form)
+{
+	return form == EXPANDRULE_QM_ADD_SNAPSHOT ||
+		   form == EXPANDRULE_INFO_ADD_DELTA ||
+		   form == EXPANDRULE_INFO_DELETE_DELTA;
+}
+
+bool expandrule_form_is_revoke(expandrule_wire_form_t form)
+{
+	return form == EXPANDRULE_INFO_REVOKE_V1 ||
+		   form == EXPANDRULE_INFO_REVOKE_LEGACY;
+}
+
+uint8_t expandrule_form_payload_type(expandrule_wire_form_t form)
+{
+	switch (form)
+	{
+		case EXPANDRULE_QM_ADD_SNAPSHOT:
+		case EXPANDRULE_INFO_ADD_DELTA:
+			return EXPANDRULE_PAYLOAD_ADD;
+		case EXPANDRULE_INFO_DELETE_DELTA:
+		case EXPANDRULE_INFO_REVOKE_V1:
+			return EXPANDRULE_PAYLOAD_DELETE;
+		case EXPANDRULE_INFO_REVOKE_LEGACY:
+			return EXPANDRULE_PAYLOAD_LEGACY_REVOKE;
+	}
+	return 0;
+}
+
+expandrule_direction_t expandrule_form_direction(expandrule_wire_form_t form)
+{
+	if (expandrule_form_is_client(form))
+	{
+		return EXPANDRULE_CLIENT_TO_SERVER;
+	}
+	if (expandrule_form_is_revoke(form))
+	{
+		return EXPANDRULE_SERVER_TO_CLIENT;
+	}
+	return EXPANDRULE_DIRECTION_UNKNOWN;
+}
+
+const char *expandrule_error_name(expandrule_error_code_t code)
+{
+	switch (code)
+	{
+		case EXPANDRULE_ERROR_NONE: return "none";
+		case EXPANDRULE_ERROR_INVALID_ARGUMENT: return "invalid_argument";
+		case EXPANDRULE_ERROR_UNSUPPORTED_CONTEXT: return "unsupported_context";
+		case EXPANDRULE_ERROR_INVALID_HEADER: return "invalid_header";
+		case EXPANDRULE_ERROR_INVALID_LENGTH: return "invalid_length";
+		case EXPANDRULE_ERROR_INVALID_FLAGS: return "invalid_flags";
+		case EXPANDRULE_ERROR_TRUNCATED: return "truncated";
+		case EXPANDRULE_ERROR_COUNT_LIMIT: return "count_limit";
+		case EXPANDRULE_ERROR_VALUE_LENGTH: return "value_length";
+		case EXPANDRULE_ERROR_INVALID_MASK: return "invalid_mask";
+		case EXPANDRULE_ERROR_INVALID_PREFIX: return "invalid_prefix";
+		case EXPANDRULE_ERROR_DUPLICATE: return "duplicate";
+		case EXPANDRULE_ERROR_INVALID_CARDINALITY: return "invalid_cardinality";
+		case EXPANDRULE_ERROR_TRAILING_DATA: return "trailing_data";
+		case EXPANDRULE_ERROR_OVERSIZE: return "oversize";
+		case EXPANDRULE_ERROR_OUT_OF_MEMORY: return "out_of_memory";
+	}
+	return "unknown";
+}
diff --git a/src/libcharon/encoding/payloads/expandrule_profile.c b/src/libcharon/encoding/payloads/expandrule_profile.c
new file mode 100644
index 0000000..3ae50bd
--- /dev/null
+++ b/src/libcharon/encoding/payloads/expandrule_profile.c
@@ -0,0 +1,151 @@
+/*
+ * Copyright (C) 2026 Zhuoyuan Hao
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation; either version 2 of the License, or (at your
+ * option) any later version.  See <http://www.fsf.org/copyleft/gpl.txt>.
+ */
+
+#include "expandrule_codec_internal.h"
+
+static bool validate_opaque(const expandrule_record_t *records, size_t index,
+							   size_t maximum, expandrule_error_t *error)
+{
+	const expandrule_record_t *record = &records[index];
+
+	if ((!record->value.ptr && record->value.len) || !record->value.len ||
+		record->value.len > maximum || record->prefix_length != 0)
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_VALUE_LENGTH, 4);
+	}
+	if (expandrule_record_duplicate(records, index, record->value, 0, FALSE))
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_DUPLICATE, 4);
+	}
+	return TRUE;
+}
+
+static bool validate_address(const expandrule_record_t *records, size_t index,
+								expandrule_family_t family,
+								expandrule_error_t *error)
+{
+	const expandrule_record_t *record = &records[index];
+	size_t address_size = expandrule_family_size(family);
+	uint8_t maximum = family == EXPANDRULE_IPV4 ? 32 : 128;
+
+	if (!record->value.ptr || record->value.len != address_size)
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_VALUE_LENGTH, 4);
+	}
+	if (record->prefix_length > maximum)
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_INVALID_PREFIX, 4);
+	}
+	if (expandrule_record_duplicate(records, index, record->value,
+									record->prefix_length, TRUE))
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_DUPLICATE, 4);
+	}
+	return TRUE;
+}
+
+static bool validate_client(expandrule_wire_form_t form,
+							const expandrule_client_envelope_t *client,
+							expandrule_error_t *error)
+{
+	size_t address_size, maximum, i;
+
+	address_size = expandrule_family_size(client->family);
+	if (!address_size ||
+		(client->dialect != EXPANDRULE_DIALECT_0 &&
+		 client->dialect != EXPANDRULE_DIALECT_1))
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_INVALID_ARGUMENT, 4);
+	}
+	if (!client->leading_address.ptr ||
+		client->leading_address.len != address_size)
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_VALUE_LENGTH, 4);
+	}
+	if (client->primary_count > EXPANDRULE_MAX_RECORDS ||
+		client->secondary_count > EXPANDRULE_MAX_RECORDS)
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_COUNT_LIMIT, 4);
+	}
+	if ((client->primary_count && !client->primary) ||
+		(client->secondary_count && !client->secondary))
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_INVALID_ARGUMENT, 4);
+	}
+	if ((form == EXPANDRULE_INFO_ADD_DELTA ||
+		 form == EXPANDRULE_INFO_DELETE_DELTA) &&
+		client->primary_count + client->secondary_count != 1)
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_INVALID_CARDINALITY, 4);
+	}
+
+	for (i = 0; i < client->primary_count; i++)
+	{
+		if (client->dialect == EXPANDRULE_DIALECT_0)
+		{
+			if (!validate_address(client->primary, i, client->family, error))
+			{
+				return FALSE;
+			}
+		}
+		else if (!validate_opaque(client->primary, i,
+									EXPANDRULE_MAX_DIALECT1_OPAQUE_LENGTH, error))
+		{
+			return FALSE;
+		}
+	}
+	maximum = client->dialect == EXPANDRULE_DIALECT_0 ?
+				  EXPANDRULE_MAX_DIALECT0_OPAQUE_LENGTH :
+				  EXPANDRULE_MAX_DIALECT1_OPAQUE_LENGTH;
+	for (i = 0; i < client->secondary_count; i++)
+	{
+		if (!validate_opaque(client->secondary, i, maximum, error))
+		{
+			return FALSE;
+		}
+	}
+	return TRUE;
+}
+
+bool expandrule_profile_validate(expandrule_wire_form_t form,
+								 const expandrule_message_t *message,
+								 expandrule_error_t *error)
+{
+	expandrule_clear_error(error);
+	if (!message || (!expandrule_form_is_client(form) &&
+					 !expandrule_form_is_revoke(form)))
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_INVALID_ARGUMENT, 0);
+	}
+	if (message->next_payload != 0)
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_INVALID_HEADER, 0);
+	}
+	if (expandrule_form_is_client(form))
+	{
+		if (message->kind != EXPANDRULE_CLIENT_ENVELOPE)
+		{
+			return expandrule_fail(error, EXPANDRULE_ERROR_UNSUPPORTED_CONTEXT, 0);
+		}
+		return validate_client(form, &message->data.client, error);
+	}
+	if (message->kind != EXPANDRULE_SERVER_REVOKE)
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_UNSUPPORTED_CONTEXT, 0);
+	}
+	if (!message->data.revoke.opaque_value.ptr ||
+		!message->data.revoke.opaque_value.len ||
+		message->data.revoke.opaque_value.len >
+			EXPANDRULE_MAX_REVOKE_OPAQUE_LENGTH ||
+		expandrule_chunk_has_nul(message->data.revoke.opaque_value))
+	{
+		return expandrule_fail(error, EXPANDRULE_ERROR_VALUE_LENGTH, 5);
+	}
+	return TRUE;
+}
diff --git a/src/libcharon/encoding/payloads/expandrule_revoke_codec.c b/src/libcharon/encoding/payloads/expandrule_revoke_codec.c
new file mode 100644
index 0000000..0ab7d4b
--- /dev/null
+++ b/src/libcharon/encoding/payloads/expandrule_revoke_codec.c
@@ -0,0 +1,69 @@
+/*
+ * Copyright (C) 2026 Zhuoyuan Hao
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation; either version 2 of the License, or (at your
+ * option) any later version.  See <http://www.fsf.org/copyleft/gpl.txt>.
+ */
+
+#include "expandrule_codec_internal.h"
+
+#include <bio/bio_reader.h>
+#include <bio/bio_writer.h>
+
+bool expandrule_revoke_decode(uint8_t raw_flags, chunk_t body,
+							  size_t body_offset,
+							  expandrule_message_t **message,
+							  expandrule_error_t *error)
+{
+	expandrule_message_t *decoded;
+	bio_reader_t *reader;
+	chunk_t opaque_value;
+
+	reader = bio_reader_create(body);
+	if (!reader->read_data8(reader, &opaque_value))
+	{
+		expandrule_fail(error, EXPANDRULE_ERROR_TRUNCATED, body_offset);
+		reader->destroy(reader);
+		return FALSE;
+	}
+	if (reader->remaining(reader))
+	{
+		expandrule_fail(error, EXPANDRULE_ERROR_TRAILING_DATA,
+						body_offset + body.len - reader->remaining(reader));
+		reader->destroy(reader);
+		return FALSE;
+	}
+	decoded = calloc(1, sizeof(*decoded));
+	if (!decoded)
+	{
+		expandrule_fail(error, EXPANDRULE_ERROR_OUT_OF_MEMORY, body_offset);
+		reader->destroy(reader);
+		return FALSE;
+	}
+	decoded->kind = EXPANDRULE_SERVER_REVOKE;
+	decoded->data.revoke.raw_flags = raw_flags;
+	decoded->data.revoke.opaque_value = chunk_clone(opaque_value);
+	reader->destroy(reader);
+	if (opaque_value.len && !decoded->data.revoke.opaque_value.ptr)
+	{
+		expandrule_message_destroy(decoded);
+		return expandrule_fail(error, EXPANDRULE_ERROR_OUT_OF_MEMORY,
+								body_offset + 1);
+	}
+	*message = decoded;
+	return TRUE;
+}
+
+bool expandrule_revoke_encode(const expandrule_server_revoke_t *revoke,
+							  chunk_t *body, expandrule_error_t *error)
+{
+	bio_writer_t *writer;
+
+	writer = bio_writer_create(1 + revoke->opaque_value.len);
+	writer->write_data8(writer, revoke->opaque_value);
+	*body = writer->extract_buf(writer);
+	writer->destroy(writer);
+	return TRUE;
+}
diff --git a/src/libcharon/tests/Makefile.am b/src/libcharon/tests/Makefile.am
index 1d92501..7cad89f 100644
--- a/src/libcharon/tests/Makefile.am
+++ b/src/libcharon/tests/Makefile.am
@@ -9,6 +9,15 @@ libcharon_tests_SOURCES = \
   suites/test_message_chapoly.c \
