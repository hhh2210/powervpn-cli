@@ -0,0 +1,285 @@
+/*
+ * Copyright (C) 2026 Zhuoyuan Hao
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation; either version 2 of the License, or (at your
+ * option) any later version.  See <http://www.fsf.org/copyleft/gpl.txt>.
+ */
+
+#include "test_suite.h"
+#include "expandrule_test_fixtures.h"
+
+#include <encoding/payloads/expandrule_codec.h>
+
+typedef struct {
+	expandrule_wire_form_t form;
+	expandrule_dialect_t dialect;
+	uint8_t *data;
+	size_t length;
+} fixture_context_t;
+
+static void assert_decode_error(expandrule_wire_form_t form,
+								expandrule_dialect_t dialect, chunk_t payload,
+								expandrule_error_code_t code)
+{
+	expandrule_message_t *message = NULL;
+	expandrule_error_t error;
+
+	ck_assert(!expandrule_codec_decode(form, dialect, payload, &message, &error));
+	ck_assert(message == NULL);
+	ck_assert_int_eq(error.code, code);
+}
+
+START_TEST(test_all_strict_prefixes_fail)
+{
+	fixture_context_t fixtures[] = {
+		{ EXPANDRULE_QM_ADD_SNAPSHOT, EXPANDRULE_DIALECT_0,
+		  expandrule_v4_d0_bytes, sizeof(expandrule_v4_d0_bytes) },
+		{ EXPANDRULE_QM_ADD_SNAPSHOT, EXPANDRULE_DIALECT_0,
+		  expandrule_v6_d0_bytes, sizeof(expandrule_v6_d0_bytes) },
+		{ EXPANDRULE_QM_ADD_SNAPSHOT, EXPANDRULE_DIALECT_1,
+		  expandrule_v4_d1_bytes, sizeof(expandrule_v4_d1_bytes) },
+		{ EXPANDRULE_QM_ADD_SNAPSHOT, EXPANDRULE_DIALECT_0,
+		  expandrule_empty_v4_bytes, sizeof(expandrule_empty_v4_bytes) },
+		{ EXPANDRULE_QM_ADD_SNAPSHOT, EXPANDRULE_DIALECT_1,
+		  expandrule_empty_v6_bytes, sizeof(expandrule_empty_v6_bytes) },
+		{ EXPANDRULE_INFO_DELETE_DELTA, EXPANDRULE_DIALECT_0,
+		  expandrule_single_delta_bytes, sizeof(expandrule_single_delta_bytes) },
+		{ EXPANDRULE_INFO_REVOKE_V1, EXPANDRULE_DIALECT_NONE,
+		  expandrule_revoke_bytes, sizeof(expandrule_revoke_bytes) },
+	};
+	expandrule_message_t *message;
+	expandrule_error_t error;
+	size_t fixture, length;
+
+	for (fixture = 0; fixture < countof(fixtures); fixture++)
+	{
+		for (length = 0; length < fixtures[fixture].length; length++)
+		{
+			message = NULL;
+			ck_assert(!expandrule_codec_decode(fixtures[fixture].form,
+							 fixtures[fixture].dialect,
+							 chunk_create(fixtures[fixture].data, length),
+							 &message, &error));
+			ck_assert(message == NULL);
+			ck_assert(error.code != EXPANDRULE_ERROR_NONE);
+		}
+	}
+}
+END_TEST
+
+START_TEST(test_header_and_context_validation)
+{
+	uint8_t buffer[sizeof(expandrule_single_delta_bytes) + 1];
+	chunk_t payload;
+
+	memcpy(buffer, expandrule_single_delta_bytes,
+		   sizeof(expandrule_single_delta_bytes));
+	payload = chunk_create(buffer, sizeof(expandrule_single_delta_bytes));
+	buffer[1] = 1;
+	assert_decode_error(EXPANDRULE_INFO_ADD_DELTA,
+					EXPANDRULE_DIALECT_0, payload,
+					EXPANDRULE_ERROR_INVALID_FLAGS);
+	buffer[1] = 0;
+	buffer[2] = 0;
+	buffer[3] = sizeof(expandrule_single_delta_bytes) - 1;
+	assert_decode_error(EXPANDRULE_INFO_ADD_DELTA,
+					EXPANDRULE_DIALECT_0, payload,
+					EXPANDRULE_ERROR_INVALID_LENGTH);
+	buffer[3] = sizeof(expandrule_single_delta_bytes) + 1;
+	assert_decode_error(EXPANDRULE_INFO_ADD_DELTA,
+					EXPANDRULE_DIALECT_0, payload,
+					EXPANDRULE_ERROR_INVALID_LENGTH);
+
+	assert_decode_error(EXPANDRULE_INFO_ADD_DELTA, EXPANDRULE_DIALECT_NONE,
+					payload, EXPANDRULE_ERROR_UNSUPPORTED_CONTEXT);
+	assert_decode_error(EXPANDRULE_INFO_REVOKE_V1,
+					EXPANDRULE_DIALECT_0,
+					expandrule_fixture(expandrule_revoke_bytes,
+								   sizeof(expandrule_revoke_bytes)),
+					EXPANDRULE_ERROR_UNSUPPORTED_CONTEXT);
+	assert_decode_error((expandrule_wire_form_t)99,
+					EXPANDRULE_DIALECT_NONE, payload,
+					EXPANDRULE_ERROR_UNSUPPORTED_CONTEXT);
+}
+END_TEST
+
+START_TEST(test_noncanonical_header_is_structurally_preserved)
+{
+	uint8_t buffer[sizeof(expandrule_single_delta_bytes)];
+	expandrule_message_t *message;
+	expandrule_error_t error;
+
+	memcpy(buffer, expandrule_single_delta_bytes, sizeof(buffer));
+	buffer[0] = 42;
+	ck_assert(expandrule_codec_decode(EXPANDRULE_INFO_ADD_DELTA,
+								  EXPANDRULE_DIALECT_0,
+								  chunk_create(buffer, sizeof(buffer)),
+								  &message, &error));
+	ck_assert_int_eq(message->next_payload, 42);
+	ck_assert(!expandrule_profile_validate(EXPANDRULE_INFO_ADD_DELTA,
+									   message, &error));
+	ck_assert_int_eq(error.code, EXPANDRULE_ERROR_INVALID_HEADER);
+	expandrule_message_destroy(message);
+}
+END_TEST
+
+START_TEST(test_invalid_mask_and_prefix)
+{
+	uint8_t v4[sizeof(expandrule_single_delta_bytes)];
+	uint8_t v6[sizeof(expandrule_v6_d0_bytes)];
+
+	memcpy(v4, expandrule_single_delta_bytes, sizeof(v4));
+	v4[16] = 0xff;
+	v4[17] = 0x00;
+	v4[18] = 0xff;
+	v4[19] = 0x00;
+	assert_decode_error(EXPANDRULE_INFO_ADD_DELTA,
+					EXPANDRULE_DIALECT_0,
+					chunk_create(v4, sizeof(v4)),
+					EXPANDRULE_ERROR_INVALID_MASK);
+
+	memcpy(v6, expandrule_v6_d0_bytes, sizeof(v6));
+	v6[40] = 0;
+	v6[41] = 0;
+	v6[42] = 0;
+	v6[43] = 129;
+	assert_decode_error(EXPANDRULE_QM_ADD_SNAPSHOT,
+					EXPANDRULE_DIALECT_0,
+					chunk_create(v6, sizeof(v6)),
+					EXPANDRULE_ERROR_INVALID_PREFIX);
+}
+END_TEST
+
+START_TEST(test_count_length_and_trailing_validation)
+{
+	uint8_t count[sizeof(expandrule_empty_v4_bytes)];
+	uint8_t variable[sizeof(expandrule_v4_d1_bytes)];
+	uint8_t trailing[sizeof(expandrule_single_delta_bytes) + 1];
+
+	memcpy(count, expandrule_empty_v4_bytes, sizeof(count));
+	count[8] = 0;
+	count[9] = 0;
+	count[10] = 0x10;
+	count[11] = 0x01;
+	assert_decode_error(EXPANDRULE_QM_ADD_SNAPSHOT,
+					EXPANDRULE_DIALECT_0,
+					chunk_create(count, sizeof(count)),
+					EXPANDRULE_ERROR_COUNT_LIMIT);
+
+	memcpy(variable, expandrule_v4_d1_bytes, sizeof(variable));
+	variable[12] = 0xff;
+	assert_decode_error(EXPANDRULE_QM_ADD_SNAPSHOT,
+					EXPANDRULE_DIALECT_1,
+					chunk_create(variable, sizeof(variable)),
+					EXPANDRULE_ERROR_TRUNCATED);
+
+	memcpy(trailing, expandrule_single_delta_bytes,
+		   sizeof(expandrule_single_delta_bytes));
+	trailing[sizeof(trailing) - 1] = 0xa5;
+	trailing[3] = sizeof(trailing);
+	assert_decode_error(EXPANDRULE_INFO_ADD_DELTA,
+					EXPANDRULE_DIALECT_0,
+					chunk_create(trailing, sizeof(trailing)),
+					EXPANDRULE_ERROR_TRAILING_DATA);
+}
+END_TEST
+
+START_TEST(test_duplicate_and_empty_opaque_are_structural)
+{
+	uint8_t duplicates[] = {
+		0x00,0x00,0x00,0x1a,0xc0,0x00,0x02,0x0a,0x00,0x00,0x00,0x02,
+		0x04,0x01,0x02,0x03,0x04,0x04,0x01,0x02,0x03,0x04,
+		0x00,0x00,0x00,0x00,
+	};
+	uint8_t empty[] = {
+		0x00,0x00,0x00,0x11,0xc0,0x00,0x02,0x0a,0x00,0x00,0x00,0x01,
+		0x00,0x00,0x00,0x00,0x00,
+	};
+	expandrule_message_t *message;
+	expandrule_error_t error;
+
+	ck_assert(expandrule_codec_decode(EXPANDRULE_QM_ADD_SNAPSHOT,
+								  EXPANDRULE_DIALECT_1,
+								  chunk_from_thing(duplicates), &message,
+								  &error));
+	ck_assert(!expandrule_profile_validate(EXPANDRULE_QM_ADD_SNAPSHOT,
+									   message, &error));
+	ck_assert_int_eq(error.code, EXPANDRULE_ERROR_DUPLICATE);
+	expandrule_message_destroy(message);
+
+	ck_assert(expandrule_codec_decode(EXPANDRULE_QM_ADD_SNAPSHOT,
+								  EXPANDRULE_DIALECT_1,
+								  chunk_from_thing(empty), &message, &error));
+	ck_assert_int_eq(message->data.client.primary[0].value.len, 0);
+	ck_assert(!expandrule_profile_validate(EXPANDRULE_QM_ADD_SNAPSHOT,
+									   message, &error));
+	ck_assert_int_eq(error.code, EXPANDRULE_ERROR_VALUE_LENGTH);
+	expandrule_message_destroy(message);
+}
+END_TEST
+
+START_TEST(test_informational_cardinality)
+{
+	expandrule_message_t *message;
+	expandrule_error_t error;
+	chunk_t encoded;
+
+	ck_assert(expandrule_codec_decode(EXPANDRULE_INFO_ADD_DELTA,
+								  EXPANDRULE_DIALECT_0,
+								  expandrule_fixture(expandrule_empty_v4_bytes,
+									  sizeof(expandrule_empty_v4_bytes)),
+								  &message, &error));
+	ck_assert(!expandrule_profile_validate(EXPANDRULE_INFO_ADD_DELTA,
+									   message, &error));
+	ck_assert_int_eq(error.code, EXPANDRULE_ERROR_INVALID_CARDINALITY);
+	ck_assert(!expandrule_codec_encode(EXPANDRULE_INFO_ADD_DELTA, message,
+									   &encoded, &error));
+	ck_assert_int_eq(error.code, EXPANDRULE_ERROR_INVALID_CARDINALITY);
+	expandrule_message_destroy(message);
+}
+END_TEST
+
+START_TEST(test_revoke_profile_and_raw_flags)
+{
+	uint8_t raw[sizeof(expandrule_revoke_bytes)];
+	uint8_t embedded_nul[] = {
+		0x00,0xa5,0x00,0x08,0x03,0x61,0x00,0x62,
+	};
+	expandrule_message_t *message;
+	expandrule_error_t error;
+
+	memcpy(raw, expandrule_revoke_bytes, sizeof(raw));
+	raw[1] = 0xa5;
+	ck_assert(expandrule_codec_decode(EXPANDRULE_INFO_REVOKE_V1,
+								  EXPANDRULE_DIALECT_NONE,
+								  chunk_create(raw, sizeof(raw)), &message,
+								  &error));
+	ck_assert_int_eq(message->data.revoke.raw_flags, 0xa5);
+	ck_assert(expandrule_profile_validate(EXPANDRULE_INFO_REVOKE_V1,
+									  message, &error));
+	expandrule_message_destroy(message);
+
+	ck_assert(expandrule_codec_decode(EXPANDRULE_INFO_REVOKE_V1,
+								  EXPANDRULE_DIALECT_NONE,
+								  chunk_from_thing(embedded_nul), &message,
+								  &error));
+	ck_assert(!expandrule_profile_validate(EXPANDRULE_INFO_REVOKE_V1,
+									   message, &error));
+	ck_assert_int_eq(error.code, EXPANDRULE_ERROR_VALUE_LENGTH);
+	expandrule_message_destroy(message);
+}
+END_TEST
+
+void expandrule_add_invalid_tests(TCase *tc)
+{
+	tcase_add_test(tc, test_all_strict_prefixes_fail);
+	tcase_add_test(tc, test_header_and_context_validation);
+	tcase_add_test(tc, test_noncanonical_header_is_structurally_preserved);
+	tcase_add_test(tc, test_invalid_mask_and_prefix);
+	tcase_add_test(tc, test_count_length_and_trailing_validation);
+	tcase_add_test(tc, test_duplicate_and_empty_opaque_are_structural);
+	tcase_add_test(tc, test_informational_cardinality);
+	tcase_add_test(tc, test_revoke_profile_and_raw_flags);
+}
