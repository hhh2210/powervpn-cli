+ * WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY
+ * or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+ * for more details.
+ */
+
+/**
+ * @defgroup expandrule_codec expandrule_codec
+ * @{ @ingroup payloads
+ */
+
+#ifndef EXPANDRULE_CODEC_H_
+#define EXPANDRULE_CODEC_H_
+
+#include <library.h>
+
+/** Private IKEv1 payload types used by the observed vendor protocol. */
+enum {
+	EXPANDRULE_PAYLOAD_LEGACY_REVOKE = 17,
+	EXPANDRULE_PAYLOAD_ADD = 18,
+	EXPANDRULE_PAYLOAD_DELETE = 19,
+};
+
+/** Local count cap plus inferred canonical profile limits, not wire limits. */
+enum {
+	EXPANDRULE_MAX_RECORDS = 4096,
+	EXPANDRULE_MAX_DIALECT0_OPAQUE_LENGTH = 64,
+	EXPANDRULE_MAX_DIALECT1_OPAQUE_LENGTH = 16,
+	EXPANDRULE_MAX_REVOKE_OPAQUE_LENGTH = 63,
+};
+
+typedef enum expandrule_wire_form_t expandrule_wire_form_t;
+typedef enum expandrule_direction_t expandrule_direction_t;
+typedef enum expandrule_dialect_t expandrule_dialect_t;
+typedef enum expandrule_family_t expandrule_family_t;
+typedef enum expandrule_message_kind_t expandrule_message_kind_t;
+typedef enum expandrule_error_code_t expandrule_error_code_t;
+typedef struct expandrule_record_t expandrule_record_t;
+typedef struct expandrule_client_envelope_t expandrule_client_envelope_t;
+typedef struct expandrule_server_revoke_t expandrule_server_revoke_t;
+typedef struct expandrule_message_t expandrule_message_t;
+typedef struct expandrule_error_t expandrule_error_t;
+
+enum expandrule_direction_t {
+	EXPANDRULE_DIRECTION_UNKNOWN,
+	EXPANDRULE_CLIENT_TO_SERVER,
+	EXPANDRULE_SERVER_TO_CLIENT,
+};
+
+/** Canonical flow context; current payload type is carried by the predecessor. */
+enum expandrule_wire_form_t {
+	EXPANDRULE_QM_ADD_SNAPSHOT,
+	EXPANDRULE_INFO_ADD_DELTA,
+	EXPANDRULE_INFO_DELETE_DELTA,
+	EXPANDRULE_INFO_REVOKE_V1,
+	EXPANDRULE_INFO_REVOKE_LEGACY,
+};
+
+enum expandrule_dialect_t {
+	EXPANDRULE_DIALECT_NONE,
+	EXPANDRULE_DIALECT_0,
+	EXPANDRULE_DIALECT_1,
+};
+
+enum expandrule_family_t {
+	EXPANDRULE_IPV4,
+	EXPANDRULE_IPV6,
+};
+
+enum expandrule_message_kind_t {
+	EXPANDRULE_CLIENT_ENVELOPE,
+	EXPANDRULE_SERVER_REVOKE,
+};
+
+/**
+ * Safe error classes.  No payload bytes or opaque values are retained.
+ */
+enum expandrule_error_code_t {
+	EXPANDRULE_ERROR_NONE,
+	EXPANDRULE_ERROR_INVALID_ARGUMENT,
+	EXPANDRULE_ERROR_UNSUPPORTED_CONTEXT,
+	EXPANDRULE_ERROR_INVALID_HEADER,
+	EXPANDRULE_ERROR_INVALID_LENGTH,
+	EXPANDRULE_ERROR_INVALID_FLAGS,
+	EXPANDRULE_ERROR_TRUNCATED,
+	EXPANDRULE_ERROR_COUNT_LIMIT,
+	EXPANDRULE_ERROR_VALUE_LENGTH,
+	EXPANDRULE_ERROR_INVALID_MASK,
+	EXPANDRULE_ERROR_INVALID_PREFIX,
+	EXPANDRULE_ERROR_DUPLICATE,
+	EXPANDRULE_ERROR_INVALID_CARDINALITY,
+	EXPANDRULE_ERROR_TRAILING_DATA,
+	EXPANDRULE_ERROR_OVERSIZE,
+	EXPANDRULE_ERROR_OUT_OF_MEMORY,
+};
+
+/**
+ * A primary or secondary record.
+ *
+ * In dialect 0, primary value has address/prefix wire syntax and
+ * prefix_length is significant.  All other values are opaque bytes and have
+ * a zero prefix_length.  Their business meaning and string encoding remain
+ * deliberately unassigned until the semantic promotion gate.
+ */
+struct expandrule_record_t {
+	chunk_t value;
+	uint8_t prefix_length;
+};
+
+/** Full client-to-server body used by ADDRULE and active DELRULE. */
+struct expandrule_client_envelope_t {
+	expandrule_family_t family;
+	expandrule_dialect_t dialect;
+	chunk_t leading_address;
+	size_t primary_count;
+	expandrule_record_t *primary;
+	size_t secondary_count;
+	expandrule_record_t *secondary;
+};
+
+/** Short server-to-client revoke body used by DELRULE and legacy type 17. */
+struct expandrule_server_revoke_t {
+	uint8_t raw_flags;
+	chunk_t opaque_value;
+};
+
+struct expandrule_message_t {
+	expandrule_message_kind_t kind;
+	uint8_t next_payload;
+	union {
+		expandrule_client_envelope_t client;
+		expandrule_server_revoke_t revoke;
+	} data;
+};
+
+/** Structured, non-sensitive failure metadata. */
+struct expandrule_error_t {
+	expandrule_error_code_t code;
+	size_t offset;
+};
+
+/**
+ * Decode a complete private payload, including its four-byte generic header.
+ *
+ * Dialect is required for client envelopes and must be NONE for server revoke
+ * payloads.  On success, the returned message owns cloned buffers and must be
+ * destroyed with expandrule_message_destroy().
+ */
+bool expandrule_codec_decode(expandrule_wire_form_t form,
+							 expandrule_dialect_t dialect, chunk_t payload,
+							 expandrule_message_t **message,
+							 expandrule_error_t *error);
+
+/**
+ * Encode a complete private payload, including its four-byte generic header.
+ *
+ * Type 17 is receive-only and is rejected by this function.  The input model
+ * remains owned by the caller.  On success, payload owns an allocated buffer.
+ */
+bool expandrule_codec_encode(expandrule_wire_form_t form,
+							 const expandrule_message_t *message,
+							 chunk_t *payload, expandrule_error_t *error);
+
+/** Validate the canonical/local safety profile; inferred limits are not wire facts. */
+bool expandrule_profile_validate(expandrule_wire_form_t form,
+								 const expandrule_message_t *message,
+								 expandrule_error_t *error);
+
+/** Map flow context to the current payload type carried by the predecessor. */
+uint8_t expandrule_form_payload_type(expandrule_wire_form_t form);
+
+/** Map flow context to its observed direction. */
+expandrule_direction_t expandrule_form_direction(expandrule_wire_form_t form);
+
+/** Destroy a message returned by expandrule_codec_decode(). */
+void expandrule_message_destroy(expandrule_message_t *message);
+
+/** Return a stable, non-sensitive name for an error code. */
+const char *expandrule_error_name(expandrule_error_code_t code);
+
+#endif /** EXPANDRULE_CODEC_H_ @}*/
