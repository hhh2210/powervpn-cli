+++ b/src/libcharon/tests/suites/test_expandrule_codec.c
@@ -0,0 +1,287 @@
+/*
+ * Copyright (C) 2026 Zhuoyuan Hao
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation; either version 2 of the License, or (at your
+ * option) any later version.  See <http://www.fsf.org/copyleft/gpl.txt>.
+ */
+
+#include "test_suite.h"
+#include "expandrule_test_fixtures.h"
+
+#include <encoding/payloads/expandrule_codec.h>
+
+static void assert_encode(expandrule_wire_form_t form,
+						  expandrule_message_t *message, chunk_t expected)
+{
+	expandrule_error_t error;
+	chunk_t first, second;
+
+	ck_assert(expandrule_codec_encode(form, message, &first, &error));
+	ck_assert_msg(chunk_equals(first, expected), "encoded bytes differ");
+	ck_assert(expandrule_codec_encode(form, message, &second, &error));
+	ck_assert_msg(chunk_equals(first, second), "encoding is not deterministic");
+	chunk_free(&first);
+	chunk_free(&second);
+}
+
+static expandrule_message_t *decode_profile(expandrule_wire_form_t form,
+											expandrule_dialect_t dialect,
+											chunk_t payload)
+{
+	expandrule_message_t *message;
+	expandrule_error_t error;
+
+	ck_assert_msg(expandrule_codec_decode(form, dialect, payload, &message,
+										&error),
+				  "decode failed: %s", expandrule_error_name(error.code));
+	ck_assert_msg(expandrule_profile_validate(form, message, &error),
+				  "profile failed: %s", expandrule_error_name(error.code));
+	return message;
+}
+
+START_TEST(test_v4_dialect0_snapshot)
+{
+	expandrule_record_t primary[] = {
+		{ .value = chunk_from_chars(0xc6,0x33,0x64,0x00),
+		  .prefix_length = 24 },
+	};
+	expandrule_record_t secondary[] = {
+		{ .value = chunk_from_chars(0xde,0xad,0xbe,0xef) },
+	};
+	expandrule_message_t model = {
+		.kind = EXPANDRULE_CLIENT_ENVELOPE,
+		.data.client = {
+			.family = EXPANDRULE_IPV4,
+			.dialect = EXPANDRULE_DIALECT_0,
+			.leading_address = chunk_from_chars(0xc0,0x00,0x02,0x0a),
+			.primary_count = countof(primary),
+			.primary = primary,
+			.secondary_count = countof(secondary),
+			.secondary = secondary,
+		},
+	};
+	expandrule_message_t *decoded;
+	chunk_t expected = expandrule_fixture(expandrule_v4_d0_bytes,
+										 sizeof(expandrule_v4_d0_bytes));
+
+	assert_encode(EXPANDRULE_QM_ADD_SNAPSHOT, &model, expected);
+	decoded = decode_profile(EXPANDRULE_QM_ADD_SNAPSHOT,
+							 EXPANDRULE_DIALECT_0, expected);
+	ck_assert_int_eq(decoded->data.client.family, EXPANDRULE_IPV4);
+	ck_assert_int_eq(decoded->data.client.primary_count, 1);
+	ck_assert_int_eq(decoded->data.client.secondary_count, 1);
+	ck_assert_int_eq(decoded->data.client.primary[0].prefix_length, 24);
+	ck_assert(chunk_equals(decoded->data.client.secondary[0].value,
+						   secondary[0].value));
+	expandrule_message_destroy(decoded);
+}
+END_TEST
+
+START_TEST(test_v6_dialect0_snapshot)
+{
+	expandrule_record_t primary[] = {
+		{ .value = chunk_from_chars(
+			0x20,0x01,0x0d,0xb8,0x00,0x01,0x00,0x00,
+			0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00),
+		  .prefix_length = 64 },
+	};
+	expandrule_message_t model = {
+		.kind = EXPANDRULE_CLIENT_ENVELOPE,
+		.data.client = {
+			.family = EXPANDRULE_IPV6,
+			.dialect = EXPANDRULE_DIALECT_0,
+			.leading_address = chunk_from_chars(
+				0x20,0x01,0x0d,0xb8,0x00,0x00,0x00,0x00,
+				0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x10),
+			.primary_count = countof(primary),
+			.primary = primary,
+		},
+	};
+	expandrule_message_t *decoded;
+	chunk_t expected = expandrule_fixture(expandrule_v6_d0_bytes,
+										 sizeof(expandrule_v6_d0_bytes));
+
+	assert_encode(EXPANDRULE_QM_ADD_SNAPSHOT, &model, expected);
+	decoded = decode_profile(EXPANDRULE_QM_ADD_SNAPSHOT,
+							 EXPANDRULE_DIALECT_0, expected);
+	ck_assert_int_eq(decoded->data.client.family, EXPANDRULE_IPV6);
+	ck_assert_int_eq(decoded->data.client.primary[0].prefix_length, 64);
+	expandrule_message_destroy(decoded);
+}
+END_TEST
+
+START_TEST(test_dialect1_snapshot)
+{
+	expandrule_record_t primary[] = {
+		{ .value = chunk_from_chars(0x01,0x02,0x03,0x04) },
+	};
+	expandrule_record_t secondary[] = {
+		{ .value = chunk_from_chars(0x05,0x06,0x07,0x08) },
+	};
+	expandrule_message_t model = {
+		.kind = EXPANDRULE_CLIENT_ENVELOPE,
+		.data.client = {
+			.family = EXPANDRULE_IPV4,
+			.dialect = EXPANDRULE_DIALECT_1,
+			.leading_address = chunk_from_chars(0xc0,0x00,0x02,0x0a),
+			.primary_count = countof(primary),
+			.primary = primary,
+			.secondary_count = countof(secondary),
+			.secondary = secondary,
+		},
+	};
+	chunk_t expected = expandrule_fixture(expandrule_v4_d1_bytes,
+										 sizeof(expandrule_v4_d1_bytes));
+	expandrule_message_t *decoded;
+
+	assert_encode(EXPANDRULE_QM_ADD_SNAPSHOT, &model, expected);
+	decoded = decode_profile(EXPANDRULE_QM_ADD_SNAPSHOT,
+							 EXPANDRULE_DIALECT_1, expected);
+	ck_assert(chunk_equals(decoded->data.client.primary[0].value,
+						   primary[0].value));
+	ck_assert(chunk_equals(decoded->data.client.secondary[0].value,
+						   secondary[0].value));
+	expandrule_message_destroy(decoded);
+}
+END_TEST
+
+START_TEST(test_empty_snapshot)
+{
+	bool ipv6 = _i != 0;
+	expandrule_message_t model = {
+		.kind = EXPANDRULE_CLIENT_ENVELOPE,
+		.data.client = {
+			.family = ipv6 ? EXPANDRULE_IPV6 : EXPANDRULE_IPV4,
+			.dialect = ipv6 ? EXPANDRULE_DIALECT_1 :
+								 EXPANDRULE_DIALECT_0,
+			.leading_address = ipv6 ? chunk_from_chars(
+				0x20,0x01,0x0d,0xb8,0x00,0x00,0x00,0x00,
+				0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x10) :
+				chunk_from_chars(0xc0,0x00,0x02,0x0a),
+		},
+	};
+	chunk_t expected = ipv6 ?
+		expandrule_fixture(expandrule_empty_v6_bytes,
+						   sizeof(expandrule_empty_v6_bytes)) :
+		expandrule_fixture(expandrule_empty_v4_bytes,
+						   sizeof(expandrule_empty_v4_bytes));
+	expandrule_message_t *decoded;
+
+	assert_encode(EXPANDRULE_QM_ADD_SNAPSHOT, &model, expected);
+	decoded = decode_profile(EXPANDRULE_QM_ADD_SNAPSHOT,
+							 model.data.client.dialect, expected);
+	ck_assert_int_eq(decoded->data.client.primary_count, 0);
+	ck_assert_int_eq(decoded->data.client.secondary_count, 0);
+	expandrule_message_destroy(decoded);
+}
+END_TEST
+
+START_TEST(test_informational_single_delta)
+{
+	expandrule_record_t primary[] = {
+		{ .value = chunk_from_chars(0xc6,0x33,0x64,0x00),
+		  .prefix_length = 24 },
+	};
+	expandrule_message_t model = {
+		.kind = EXPANDRULE_CLIENT_ENVELOPE,
+		.data.client = {
+			.family = EXPANDRULE_IPV4,
+			.dialect = EXPANDRULE_DIALECT_0,
+			.leading_address = chunk_from_chars(0xc0,0x00,0x02,0x0a),
+			.primary_count = countof(primary),
+			.primary = primary,
+		},
+	};
+	chunk_t expected = expandrule_fixture(expandrule_single_delta_bytes,
+										 sizeof(expandrule_single_delta_bytes));
+	expandrule_message_t *decoded;
+
+	assert_encode(EXPANDRULE_INFO_ADD_DELTA, &model, expected);
+	assert_encode(EXPANDRULE_INFO_DELETE_DELTA, &model, expected);
+	decoded = decode_profile(EXPANDRULE_INFO_DELETE_DELTA,
+							 EXPANDRULE_DIALECT_0, expected);
+	expandrule_message_destroy(decoded);
+	ck_assert_int_eq(expandrule_form_payload_type(EXPANDRULE_INFO_ADD_DELTA), 18);
+	ck_assert_int_eq(expandrule_form_payload_type(EXPANDRULE_INFO_DELETE_DELTA), 19);
+}
+END_TEST
+
+START_TEST(test_server_revoke)
+{
+	expandrule_message_t model = {
+		.kind = EXPANDRULE_SERVER_REVOKE,
+		.data.revoke = {
+			.raw_flags = 0,
+			.opaque_value = chunk_from_chars(0xa1,0xb2,0xc3,0xd4,0xe5),
+		},
+	};
+	chunk_t expected = expandrule_fixture(expandrule_revoke_bytes,
+										 sizeof(expandrule_revoke_bytes));
+	expandrule_message_t *decoded;
+	expandrule_error_t error;
+	chunk_t encoded;
+
+	assert_encode(EXPANDRULE_INFO_REVOKE_V1, &model, expected);
+	decoded = decode_profile(EXPANDRULE_INFO_REVOKE_V1,
+							 EXPANDRULE_DIALECT_NONE, expected);
+	ck_assert(chunk_equals(decoded->data.revoke.opaque_value,
+						   model.data.revoke.opaque_value));
+	expandrule_message_destroy(decoded);
+	decoded = decode_profile(EXPANDRULE_INFO_REVOKE_LEGACY,
+							 EXPANDRULE_DIALECT_NONE, expected);
+	expandrule_message_destroy(decoded);
+	ck_assert(!expandrule_codec_encode(EXPANDRULE_INFO_REVOKE_LEGACY,
+									   &model, &encoded, &error));
+	ck_assert_int_eq(error.code, EXPANDRULE_ERROR_UNSUPPORTED_CONTEXT);
+	ck_assert_int_eq(expandrule_form_payload_type(EXPANDRULE_INFO_REVOKE_V1), 19);
+	ck_assert_int_eq(expandrule_form_payload_type(EXPANDRULE_INFO_REVOKE_LEGACY), 17);
+	ck_assert_int_eq(expandrule_form_direction(EXPANDRULE_INFO_REVOKE_V1),
+					 EXPANDRULE_SERVER_TO_CLIENT);
+}
+END_TEST
+
+START_TEST(test_input_ownership)
+{
+	chunk_t input = chunk_clone(expandrule_fixture(expandrule_single_delta_bytes,
+												   sizeof(expandrule_single_delta_bytes)));
+	chunk_t expected_address = chunk_from_chars(0xc6,0x33,0x64,0x00);
+	expandrule_message_t *message;
+	expandrule_error_t error;
+
+	ck_assert(expandrule_codec_decode(EXPANDRULE_INFO_ADD_DELTA,
+								  EXPANDRULE_DIALECT_0, input,
+								  &message, &error));
+	memwipe(input.ptr, input.len);
+	chunk_free(&input);
+	ck_assert(chunk_equals(message->data.client.primary[0].value,
+						   expected_address));
+	expandrule_message_destroy(message);
+}
+END_TEST
+
+void expandrule_add_invalid_tests(TCase *tc);
+void expandrule_add_boundary_tests(TCase *tc);
+void expandrule_add_profile_tests(TCase *tc);
+
+Suite *expandrule_codec_suite_create()
+{
+	Suite *s;
+	TCase *tc;
+
+	s = suite_create("expandrule codec");
+	tc = tcase_create("synthetic golden vectors");
+	tcase_add_test(tc, test_v4_dialect0_snapshot);
+	tcase_add_test(tc, test_v6_dialect0_snapshot);
+	tcase_add_test(tc, test_dialect1_snapshot);
+	tcase_add_loop_test(tc, test_empty_snapshot, 0, 2);
+	tcase_add_test(tc, test_informational_single_delta);
+	tcase_add_test(tc, test_server_revoke);
+	tcase_add_test(tc, test_input_ownership);
+	expandrule_add_boundary_tests(tc);
+	expandrule_add_invalid_tests(tc);
+	expandrule_add_profile_tests(tc);
+	suite_add_tcase(s, tc);
+	return s;
+}
