+/**
+ * Enforce the bounded private-payload contexts that payload_rule_t can't
+ * express (mutual exclusion and the augmented final Quick Mode packet).
+ *
+ * This is shared by outbound generation before HASH calculation and inbound
+ * verification after decryption.  Request/response is message-flow state and
+ * must not be interpreted as client/server actor direction.
+ */
+static status_t validate_expandrule_context(private_message_t *this,
+										 bool generating)
+{
+	enumerator_t *enumerator;
+	payload_t *payload;
+	size_t custom = 0, legacy = 0, hashes = 0, non_hash = 0;
+	bool add_only = TRUE, hash_order = TRUE;
+
+	enumerator = this->payloads->create_enumerator(this->payloads);
+	while (enumerator->enumerate(enumerator, &payload))
+	{
+		payload_type_t type = payload->get_type(payload);
+
+		if (type == PLV1_HASH)
+		{
+			hashes++;
+			if (non_hash)
+			{
+				hash_order = FALSE;
+			}
+			continue;
+		}
+		non_hash++;
+		if (type == PLV1_EXPANDRULE_LEGACY_REVOKE)
+		{
+			legacy++;
+		}
+		if (type == PLV1_EXPANDRULE_LEGACY_REVOKE ||
+			type == PLV1_EXPANDRULE_ADD || type == PLV1_EXPANDRULE_DELETE)
+		{
+			custom++;
+			add_only = add_only && type == PLV1_EXPANDRULE_ADD;
+		}
+	}
+	enumerator->destroy(enumerator);
+
+	if (!custom)
+	{
+		return SUCCESS;
+	}
+	if (this->major_version != IKEV1_MAJOR_VERSION)
+	{
+		return VERIFY_ERROR;
+	}
+	/* HASH is inserted by generate_message(), never by a task.  During parsing,
+	 * at most one HASH may precede the structural custom payload. */
+	if ((generating && hashes) || hashes > 1 || !hash_order ||
+		(generating && legacy))
+	{
+		return VERIFY_ERROR;
+	}
+	switch (this->exchange_type)
+	{
+		case QUICK_MODE:
+			/* LeadSec appends ADDRULE to the standard third Quick Mode packet.
+			 * HASH(3) is produced by the unmodified keymat after Ni/Nr negotiation. */
+			if (this->is_request && custom == 1 && non_hash == 1 && add_only &&
+				((generating && hashes == 0) || (!generating && hashes == 1)))
+			{
+				return SUCCESS;
+			}
+			break;
+		case INFORMATIONAL_V1:
+			/* Observed forms are custom-only requests and mutually exclusive. */
+			if (this->is_request && custom == 1 && non_hash == 1 &&
+				((generating && hashes == 0) || (!generating && hashes == 1)))
+			{
+				return SUCCESS;
+			}
+			break;
+		default:
+			break;
+	}
+	DBG1(DBG_ENC, "invalid private expandrule payload context");
+	return VERIFY_ERROR;
+}
+
+/** Whether a validated exchange contains any private expandrule payload. */
+static bool is_expandrule_exchange(private_message_t *this,
+									 exchange_type_t exchange)
+{
+	enumerator_t *enumerator;
+	payload_t *payload;
+	bool found = FALSE;
+
+	if (this->exchange_type != exchange)
+	{
+		return FALSE;
+	}
+	enumerator = this->payloads->create_enumerator(this->payloads);
+	while (enumerator->enumerate(enumerator, &payload))
+	{
+		payload_type_t type = payload->get_type(payload);
+
+		if (type == PLV1_EXPANDRULE_LEGACY_REVOKE ||
+			type == PLV1_EXPANDRULE_ADD || type == PLV1_EXPANDRULE_DELETE)
+		{
+			found = TRUE;
+			break;
+		}
+	}
+	enumerator->destroy(enumerator);
+	return found;
+}
+
 METHOD(message_t, set_ike_sa_id, void,
 	private_message_t *this,ike_sa_id_t *ike_sa_id)
 {
@@ -1768,7 +1889,7 @@ static status_t generate_message(private_message_t *this, keymat_t *keymat,
 	chunk_t hash = chunk_empty;
 	ike_header_t *ike_header;
 	payload_t *payload, *next;
-	bool encrypting = FALSE;
+	bool encrypting = FALSE, expandrule_protected, phase2_hash = FALSE;
 
 	if (this->exchange_type == EXCHANGE_TYPE_UNDEFINED)
 	{
@@ -1789,6 +1910,12 @@ static status_t generate_message(private_message_t *this, keymat_t *keymat,
 		DBG1(DBG_ENC, "no message rules specified for this message type");
 		return NOT_SUPPORTED;
 	}
+	if (validate_expandrule_context(this, TRUE) != SUCCESS)
+	{
+		return VERIFY_ERROR;
+	}
+	expandrule_protected = is_expandrule_exchange(this, QUICK_MODE) ||
+						 is_expandrule_exchange(this, INFORMATIONAL_V1);
 
 	if (!this->sort_disabled)
 	{
@@ -1805,6 +1932,7 @@ static status_t generate_message(private_message_t *this, keymat_t *keymat,
 			hash_payload = hash_payload_create(PLV1_HASH);
 			hash_payload->set_hash(hash_payload, hash);
 			this->payloads->insert_first(this->payloads, hash_payload);
+			phase2_hash = TRUE;
 			if (this->exchange_type == INFORMATIONAL_V1)
 			{
 				this->is_encrypted = encrypting = TRUE;
@@ -1812,6 +1940,11 @@ static status_t generate_message(private_message_t *this, keymat_t *keymat,
 			chunk_free(&hash);
 		}
 	}
+	if (expandrule_protected && !phase2_hash)
+	{
+		DBG1(DBG_ENC, "private expandrule payload requires Phase 2 HASH state");
+		return VERIFY_ERROR;
+	}
 
 	if (this->major_version == IKEV2_MAJOR_VERSION)
 	{
@@ -2747,6 +2880,10 @@ static status_t verify(private_message_t *this)
 	int i;
 
 	DBG2(DBG_ENC, "verifying message structure");
+	if (validate_expandrule_context(this, FALSE) != SUCCESS)
+	{
+		return VERIFY_ERROR;
+	}
 
 	/* check for payloads with wrong count */
 	for (i = 0; i < this->rule->rule_count; i++)
@@ -2798,6 +2935,7 @@ METHOD(message_t, parse_body, status_t,
 	private_message_t *this, keymat_t *keymat)
 {
 	status_t status = SUCCESS;
+	bool expandrule_protected = FALSE, phase2_hash = FALSE;
 
 	DBG2(DBG_ENC, "parsing body of message, first payload is %N",
 		 payload_type_names, this->first_payload);
@@ -2834,6 +2972,8 @@ METHOD(message_t, parse_body, status_t,
 	{
 		return status;
 	}
+	expandrule_protected = is_expandrule_exchange(this, QUICK_MODE) ||
+						 is_expandrule_exchange(this, INFORMATIONAL_V1);
 
 #if DEBUG_LEVEL >= 1
 	char str[BUF_LEN];
@@ -2875,6 +3015,12 @@ METHOD(message_t, parse_body, status_t,
 				return FAILED;
 			}
 			chunk_free(&hash);
+			phase2_hash = TRUE;
+		}
+		if (expandrule_protected && !phase2_hash)
+		{
+			DBG1(DBG_ENC, "private expandrule payload missing Phase 2 HASH state");
+			return VERIFY_ERROR;
 		}
 		if (this->is_encrypted && this->exchange_type != INFORMATIONAL_V1)
 		{	/* message verified, confirm IV */
@@ -2884,6 +3030,11 @@ METHOD(message_t, parse_body, status_t,
 			}
 		}
 	}
+	if (expandrule_protected && !phase2_hash)
+	{
+		DBG1(DBG_ENC, "private expandrule payload missing Phase 2 HASH state");
+		return VERIFY_ERROR;
+	}
 	return SUCCESS;
 }
 
