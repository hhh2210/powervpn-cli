diff --git a/src/libcharon/sa/ikev1/tasks/expandrule.c b/src/libcharon/sa/ikev1/tasks/expandrule.c
new file mode 100644
index 0000000..d3f36d0
--- /dev/null
+++ b/src/libcharon/sa/ikev1/tasks/expandrule.c
@@ -0,0 +1,293 @@
+/*
+ * Copyright (C) 2026 Zhuoyuan Hao
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation; either version 2 of the License, or (at your
+ * option) any later version.  See <http://www.fsf.org/copyleft/gpl.txt>.
+ *
+ * This program is distributed in the hope that it will be useful, but
+ * WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY
+ * or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+ * for more details.
+ */
+
+#include "expandrule.h"
+#include "expandrule_qm.h"
+#include "expandrule_task_payload.h"
+
+
+typedef struct private_expandrule_t private_expandrule_t;
+
+struct private_expandrule_t {
+	expandrule_t public;
+	expandrule_wire_form_t form;
+	expandrule_dialect_t dialect;
+	chunk_t outbound;
+	expandrule_message_t *decoded;
+	expandrule_error_t error;
+	expandrule_qm_t *qm;
+	bool complete;
+};
+
+/** Local message placement; request/response is distinct from actor direction. */
+static bool get_context(expandrule_wire_form_t form,
+						exchange_type_t *exchange, bool *request)
+{
+	switch (form)
+	{
+		case EXPANDRULE_QM_ADD_SNAPSHOT:
+			*exchange = QUICK_MODE;
+			*request = TRUE;
+			return TRUE;
+		case EXPANDRULE_INFO_ADD_DELTA:
+		case EXPANDRULE_INFO_DELETE_DELTA:
+		case EXPANDRULE_INFO_REVOKE_V1:
+		case EXPANDRULE_INFO_REVOKE_LEGACY:
+			*exchange = INFORMATIONAL_V1;
+			/* process_r handles a remote request; this is not actor direction. */
+			*request = TRUE;
+			return TRUE;
+		default:
+			return FALSE;
+	}
+}
+
+static bool valid_dialect(expandrule_wire_form_t form,
+						  expandrule_dialect_t dialect)
+{
+	if (expandrule_form_direction(form) == EXPANDRULE_CLIENT_TO_SERVER)
+	{
+		return dialect == EXPANDRULE_DIALECT_0 ||
+			   dialect == EXPANDRULE_DIALECT_1;
+	}
+	if (expandrule_form_direction(form) == EXPANDRULE_SERVER_TO_CLIENT)
+	{
+		return dialect == EXPANDRULE_DIALECT_NONE;
+	}
+	return FALSE;
+}
+
+static bool message_has_context(private_expandrule_t *this,
+									message_t *message)
+{
+	exchange_type_t exchange;
+	bool request;
+
+	return get_context(this->form, &exchange, &request) &&
+		   message->get_major_version(message) == IKEV1_MAJOR_VERSION &&
+		   message->get_exchange_type(message) == exchange &&
+			   message->get_request(message) == request;
+}
+
+/** The outbound skeleton is custom-only before message.c inserts a HASH. */
+static bool message_is_empty(message_t *message)
+{
+	enumerator_t *enumerator;
+	payload_t *payload;
+	bool empty;
+
+	enumerator = message->create_payload_enumerator(message);
+	empty = !enumerator->enumerate(enumerator, &payload);
+	enumerator->destroy(enumerator);
+	return empty;
+}
+
+static bool fail(private_expandrule_t *this, expandrule_error_code_t code,
+				 size_t offset, expandrule_error_t *error)
+{
+	this->error = (expandrule_error_t){ .code = code, .offset = offset };
+	if (error)
+	{
+		*error = this->error;
+	}
+	return FALSE;
+}
+
+METHOD(expandrule_t, set_message, bool,
+	private_expandrule_t *this, const expandrule_message_t *message,
+	expandrule_error_t *error)
+{
+	chunk_t encoded;
+
+	chunk_free(&this->outbound);
+	if (this->decoded)
+	{
+		expandrule_message_destroy(this->decoded);
+		this->decoded = NULL;
+	}
+	if (this->complete ||
+		expandrule_form_direction(this->form) != EXPANDRULE_CLIENT_TO_SERVER ||
+		!message || message->kind != EXPANDRULE_CLIENT_ENVELOPE ||
+		message->data.client.dialect != this->dialect)
+	{
+		return fail(this, EXPANDRULE_ERROR_UNSUPPORTED_CONTEXT, 0, error);
+	}
+	if (!expandrule_codec_encode(this->form, message, &encoded, &this->error))
+	{
+		if (error)
+		{
+			*error = this->error;
+		}
+		return FALSE;
+	}
+	this->outbound = encoded;
+	if (error)
+	{
+		*error = this->error;
+	}
+	return TRUE;
+}
+
+METHOD(expandrule_t, get_message, const expandrule_message_t*,
+	private_expandrule_t *this)
+{
+	return this->decoded;
+}
+
+METHOD(expandrule_t, get_error, expandrule_error_t,
+	private_expandrule_t *this)
+{
+	return this->error;
+}
+
+METHOD(task_t, build, status_t,
+	private_expandrule_t *this, message_t *message)
+{
+	status_t status;
+
+	if (expandrule_form_direction(this->form) != EXPANDRULE_CLIENT_TO_SERVER ||
+		!message_has_context(this, message) || this->outbound.len < 4)
+	{
+		fail(this, EXPANDRULE_ERROR_UNSUPPORTED_CONTEXT, 0, NULL);
+		return FAILED;
+	}
+	if (this->form == EXPANDRULE_QM_ADD_SNAPSHOT)
+	{
+		bool append;
+
+		status = this->qm->build(this->qm, message, &append);
+
+		if (status == SUCCESS && append)
+		{
+			status = expandrule_task_append_payload(this->form, this->outbound,
+												message, &this->error);
+			this->complete = status == SUCCESS;
+			return status;
+		}
+		if (status == FAILED)
+		{
+			fail(this, EXPANDRULE_ERROR_UNSUPPORTED_CONTEXT, 0, NULL);
+		}
+		return status;
+	}
+	if (this->complete || !message_is_empty(message))
+	{
+		fail(this, EXPANDRULE_ERROR_UNSUPPORTED_CONTEXT, 0, NULL);
+		return FAILED;
+	}
+	status = expandrule_task_append_payload(this->form, this->outbound,
+										 message, &this->error);
+	this->complete = status == SUCCESS;
+	return status;
+}
+
+METHOD(task_t, process, status_t,
+	private_expandrule_t *this, message_t *message)
+{
+	status_t status;
+
+	if (this->form == EXPANDRULE_QM_ADD_SNAPSHOT)
+	{
+		status_t status = this->qm->process(this->qm, message);
+
+		if (status == FAILED)
+		{
+			fail(this, EXPANDRULE_ERROR_UNSUPPORTED_CONTEXT, 0, NULL);
+		}
+		return status;
+	}
+	if (expandrule_form_direction(this->form) != EXPANDRULE_SERVER_TO_CLIENT ||
+		!message_has_context(this, message))
+	{
+		fail(this, EXPANDRULE_ERROR_UNSUPPORTED_CONTEXT, 0, NULL);
+		return FAILED;
+	}
+	if (this->complete)
+	{
+		fail(this, EXPANDRULE_ERROR_UNSUPPORTED_CONTEXT, 0, NULL);
+		return FAILED;
+	}
+	if (this->decoded)
+	{
+		expandrule_message_destroy(this->decoded);
+		this->decoded = NULL;
+	}
+	status = expandrule_task_decode_revoke(this->form, this->dialect, message,
+										&this->decoded, &this->error);
+	this->complete = status == SUCCESS;
+	return status;
+}
+
+METHOD(task_t, get_type, task_type_t,
+	private_expandrule_t *this)
+{
+	return TASK_EXPANDRULE;
+}
+
+METHOD(task_t, migrate, void,
+	private_expandrule_t *this, ike_sa_t *ike_sa)
+{
+	/* No IKE_SA is retained, but exchange timing never migrates across SAs. */
+	chunk_free(&this->outbound);
+	this->complete = FALSE;
+	if (this->qm)
+	{
+		this->qm->reset(this->qm);
+	}
+	if (this->decoded)
+	{
+		expandrule_message_destroy(this->decoded);
+		this->decoded = NULL;
+	}
+}
+
+METHOD(task_t, destroy, void,
+	private_expandrule_t *this)
+{
+	chunk_free(&this->outbound);
+	expandrule_message_destroy(this->decoded);
+	DESTROY_IF(this->qm);
+	free(this);
+}
+
+expandrule_t *expandrule_create(expandrule_wire_form_t form,
+							expandrule_dialect_t dialect)
+{
+	private_expandrule_t *this;
+	exchange_type_t exchange;
+	bool request;
+
+	if (!get_context(form, &exchange, &request) || !valid_dialect(form, dialect))
+	{
+		return NULL;
+	}
+	INIT(this,
+		.public = {
+			.task = {
+				.build = _build,
+				.process = _process,
+				.get_type = _get_type,
+				.migrate = _migrate,
+				.destroy = _destroy,
+			},
+			.set_message = _set_message,
+			.get_message = _get_message,
+			.get_error = _get_error,
+		},
+		.form = form,
+		.dialect = dialect,
+		.qm = form == EXPANDRULE_QM_ADD_SNAPSHOT ? expandrule_qm_create() : NULL,
+	);
+	return &this->public;
+}
