+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation; either version 2 of the License, or (at your
+ * option) any later version.  See <http://www.fsf.org/copyleft/gpl.txt>.
+ */
+
+#ifndef EXPANDRULE_QM_H_
+#define EXPANDRULE_QM_H_
+
+typedef struct expandrule_qm_t expandrule_qm_t;
+
+#include <library.h>
+#include <encoding/message.h>
+
+/**
+ * Explicit, unscheduled companion for the initiator's three-packet Quick Mode.
+ */
+struct expandrule_qm_t {
+
+	/**
+	 * Observe stock Quick Mode build phases.
+	 *
+	 * append is TRUE only for the empty final request after SA/NONCE negotiation.
+	 */
+	status_t (*build)(expandrule_qm_t *this, message_t *message, bool *append);
+
+	/** Observe the stock Quick Mode response without decoding private payloads. */
+	status_t (*process)(expandrule_qm_t *this, message_t *message);
+
+	/** Reset timing state without retaining an IKE_SA. */
+	void (*reset)(expandrule_qm_t *this);
+
+	/** Destroy this companion. */
+	void (*destroy)(expandrule_qm_t *this);
+};
+
+expandrule_qm_t *expandrule_qm_create(void);
+
+#endif /** EXPANDRULE_QM_H_ */
diff --git a/src/libcharon/sa/ikev1/tasks/expandrule_task_payload.c b/src/libcharon/sa/ikev1/tasks/expandrule_task_payload.c
new file mode 100644
index 0000000..7af88b5
--- /dev/null
+++ b/src/libcharon/sa/ikev1/tasks/expandrule_task_payload.c
@@ -0,0 +1,107 @@
+/*
+ * Copyright (C) 2026 Zhuoyuan Hao
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation; either version 2 of the License, or (at your
+ * option) any later version.  See <http://www.fsf.org/copyleft/gpl.txt>.
+ */
+
+#include "expandrule_task_payload.h"
+
+#include <encoding/generator.h>
+#include <encoding/payloads/expandrule_payload.h>
+
+static status_t fail(expandrule_error_t *error,
+						 expandrule_error_code_t code, size_t offset)
+{
+	*error = (expandrule_error_t){ .code = code, .offset = offset };
+	return FAILED;
+}
+
+status_t expandrule_task_append_payload(expandrule_wire_form_t form,
+										chunk_t encoded, message_t *message,
+										expandrule_error_t *error)
+{
+	expandrule_payload_t *payload;
+	chunk_t data;
+
+	data = chunk_clone(chunk_create(encoded.ptr + 4, encoded.len - 4));
+	payload = expandrule_payload_create_data(
+					(payload_type_t)expandrule_form_payload_type(form),
+					encoded.ptr[1], data);
+	if (!payload)
+	{
+		return fail(error, EXPANDRULE_ERROR_OUT_OF_MEMORY, 4);
+	}
+	message->add_payload(message, &payload->payload_interface);
+	return SUCCESS;
+}
+
+status_t expandrule_task_decode_revoke(expandrule_wire_form_t form,
+									  expandrule_dialect_t dialect,
+									  message_t *message,
+									  expandrule_message_t **decoded,
+									  expandrule_error_t *error)
+{
+	payload_type_t expected =
+					(payload_type_t)expandrule_form_payload_type(form), type;
+	expandrule_payload_t *payload = NULL;
+	payload_t *current;
+	enumerator_t *enumerator;
+	generator_t *generator;
+	chunk_t encoded;
+	size_t count = 0, hash_count = 0, position = 0;
+	bool valid = TRUE;
+
+	*decoded = NULL;
+	enumerator = message->create_payload_enumerator(message);
+	while (enumerator->enumerate(enumerator, &current))
+	{
+		type = current->get_type(current);
+		if (type == PLV1_HASH)
+		{
+			hash_count++;
+			if (position != 0 || hash_count > 1)
+			{
+				valid = FALSE;
+			}
+		}
+		else if (type == PLV1_EXPANDRULE_LEGACY_REVOKE ||
+				type == PLV1_EXPANDRULE_ADD || type == PLV1_EXPANDRULE_DELETE)
+		{
+			count++;
+			if (type == expected)
+			{
+				payload = (expandrule_payload_t*)current;
+			}
+		}
+		else
+		{
+			valid = FALSE;
+		}
+		position++;
+	}
+	enumerator->destroy(enumerator);
+	if (!valid || hash_count != 1 || count != 1 || !payload)
+	{
+		return fail(error, EXPANDRULE_ERROR_INVALID_CARDINALITY, 0);
+	}
+
+	generator = generator_create_no_dbg();
+	generator->generate_payload(generator, &payload->payload_interface);
+	encoded = generator->get_chunk(generator, NULL);
+	if (!expandrule_codec_decode(form, dialect, encoded, decoded, error))
+	{
+		generator->destroy(generator);
+		return FAILED;
+	}
+	generator->destroy(generator);
+	if (!expandrule_profile_validate(form, *decoded, error))
+	{
+		expandrule_message_destroy(*decoded);
+		*decoded = NULL;
+		return FAILED;
+	}
+	return SUCCESS;
+}
