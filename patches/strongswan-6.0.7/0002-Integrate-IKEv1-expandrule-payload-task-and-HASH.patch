+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation; either version 2 of the License, or (at your
+ * option) any later version.  See <http://www.fsf.org/copyleft/gpl.txt>.
+ *
+ * This program is distributed in the hope that it will be useful, but
+ * WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY
+ * or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+ * for more details.
+ */
+
+/**
+ * @defgroup expandrule expandrule
+ * @{ @ingroup tasks_v1
+ */
+
+#ifndef EXPANDRULE_H_
+#define EXPANDRULE_H_
+
+typedef struct expandrule_t expandrule_t;
+
+#include <library.h>
+#include <sa/task.h>
+#include <encoding/payloads/expandrule_codec.h>
+
+/**
+ * Neutral IKEv1 expandrule task.
+ *
+ * It translates between the explicit CP4A form/dialect model and an IKE
+ * payload.  For the Quick Mode snapshot it is an unscheduled companion: it
+ * waits for stock SA/NONCE negotiation and appends ADDRULE only to the empty
+ * final request.  It does not hold an IKE_SA, install policies/routes or send
+ * data.
+ */
+struct expandrule_t {
+
+	/** Implements task_t. */
+	task_t task;
+
+	/**
+	 * Configure the model to encode on build().
+	 *
+	 * The model stays owned by the caller.  A canonical encoded copy is stored
+	 * by the task, so the caller may release its buffers after this returns.
+	 */
+	bool (*set_message)(expandrule_t *this,
+					const expandrule_message_t *message,
+					expandrule_error_t *error);
+
+	/**
+	 * Return the decoded model after process().
+	 *
+	 * The result is borrowed and remains owned by the task.
+	 */
+	const expandrule_message_t *(*get_message)(expandrule_t *this);
+
+	/** Return the last value-free codec/profile error. */
+	expandrule_error_t (*get_error)(expandrule_t *this);
+};
+
+/**
+ * Create a neutral task with an explicit wire form and dialect.
+ *
+ * Client forms require dialect 0 or 1.  Revoke forms require dialect NONE.
+ * Invalid combinations return NULL.  The task is intentionally not wired
+ * into task_manager_v1; Quick Mode ordering and automatic scheduling remain a
+ * later gate.
+ */
+expandrule_t *expandrule_create(expandrule_wire_form_t form,
+							expandrule_dialect_t dialect);
+
+#endif /** EXPANDRULE_H_ @}*/
diff --git a/src/libcharon/sa/ikev1/tasks/expandrule_qm.c b/src/libcharon/sa/ikev1/tasks/expandrule_qm.c
new file mode 100644
index 0000000..54bc3f0
--- /dev/null
+++ b/src/libcharon/sa/ikev1/tasks/expandrule_qm.c
@@ -0,0 +1,154 @@
+/*
+ * Copyright (C) 2026 Zhuoyuan Hao
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation; either version 2 of the License, or (at your
+ * option) any later version.  See <http://www.fsf.org/copyleft/gpl.txt>.
+ */
+
+#include "expandrule_qm.h"
+
+#include <encoding/payloads/payload.h>
+
+typedef struct private_expandrule_qm_t private_expandrule_qm_t;
+
+typedef enum {
+	EXPANDRULE_QM_READY,
+	EXPANDRULE_QM_WAIT_RESPONSE,
+	EXPANDRULE_QM_READY_FINAL,
+	EXPANDRULE_QM_COMPLETE,
+} expandrule_qm_state_t;
+
+struct private_expandrule_qm_t {
+	expandrule_qm_t public;
+	expandrule_qm_state_t state;
+	uint32_t mid;
+};
+
+static bool message_is_empty(message_t *message)
+{
+	enumerator_t *enumerator;
+	payload_t *payload;
+	bool empty;
+
+	enumerator = message->create_payload_enumerator(message);
+	empty = !enumerator->enumerate(enumerator, &payload);
+	enumerator->destroy(enumerator);
+	return empty;
+}
+
+static bool message_has_private_payload(message_t *message)
+{
+	enumerator_t *enumerator;
+	payload_t *payload;
+	bool found = FALSE;
+
+	enumerator = message->create_payload_enumerator(message);
+	while (enumerator->enumerate(enumerator, &payload))
+	{
+		payload_type_t type = payload->get_type(payload);
+
+		if (type == PLV1_EXPANDRULE_LEGACY_REVOKE ||
+			type == PLV1_EXPANDRULE_ADD || type == PLV1_EXPANDRULE_DELETE)
+		{
+			found = TRUE;
+			break;
+		}
+	}
+	enumerator->destroy(enumerator);
+	return found;
+}
+
+/** Require the standard Quick Mode SA/NONCE phase, without interpreting it. */
+static bool message_has_standard_payloads(message_t *message)
+{
+	return !message_has_private_payload(message) &&
+		   message->get_payload(message, PLV1_SECURITY_ASSOCIATION) &&
+		   message->get_payload(message, PLV1_NONCE);
+}
+
+static bool has_context(message_t *message, bool request)
+{
+	return message->get_major_version(message) == IKEV1_MAJOR_VERSION &&
+		   message->get_exchange_type(message) == QUICK_MODE &&
+		   message->get_request(message) == request;
+}
+
+METHOD(expandrule_qm_t, build, status_t,
+	private_expandrule_qm_t *this, message_t *message, bool *append)
+{
+	*append = FALSE;
+	if (!has_context(message, TRUE))
+	{
+		return FAILED;
+	}
+	switch (this->state)
+	{
+		case EXPANDRULE_QM_READY:
+			/* Must run after stock quick_mode has added SA/NONCE. */
+			if (!message_has_standard_payloads(message))
+			{
+				return FAILED;
+			}
+			this->mid = message->get_message_id(message);
+			this->state = EXPANDRULE_QM_WAIT_RESPONSE;
+			return NEED_MORE;
+		case EXPANDRULE_QM_READY_FINAL:
+			/* Stock quick_mode has completed and left the final request empty. */
+			if (message->get_message_id(message) != this->mid ||
+				!message_is_empty(message))
+			{
+				return FAILED;
+			}
+			*append = TRUE;
+			this->state = EXPANDRULE_QM_COMPLETE;
+			return SUCCESS;
+		default:
+			return FAILED;
+	}
+}
+
+METHOD(expandrule_qm_t, process, status_t,
+	private_expandrule_qm_t *this, message_t *message)
+{
+	if (this->state != EXPANDRULE_QM_WAIT_RESPONSE ||
+		!has_context(message, FALSE) ||
+		message->get_message_id(message) != this->mid ||
+		!message_has_standard_payloads(message))
+	{
+		return FAILED;
+	}
+	/* Stock quick_mode validates and consumes this response. */
+	this->state = EXPANDRULE_QM_READY_FINAL;
+	return NEED_MORE;
+}
+
+METHOD(expandrule_qm_t, reset, void,
+	private_expandrule_qm_t *this)
+{
+	this->state = EXPANDRULE_QM_READY;
+	this->mid = 0;
+}
+
+METHOD(expandrule_qm_t, destroy, void,
+	private_expandrule_qm_t *this)
+{
+	free(this);
+}
+
+expandrule_qm_t *expandrule_qm_create(void)
+{
+	private_expandrule_qm_t *this;
+
+	INIT(this,
+		.public = {
+			.build = _build,
+			.process = _process,
+			.reset = _reset,
+			.destroy = _destroy,
+		},
+		.state = EXPANDRULE_QM_READY,
+	);
+	return &this->public;
+}
