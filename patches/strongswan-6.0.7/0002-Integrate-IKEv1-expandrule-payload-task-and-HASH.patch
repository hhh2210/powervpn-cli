diff --git a/src/libcharon/tests/suites/test_expandrule_hash.c b/src/libcharon/tests/suites/test_expandrule_hash.c
new file mode 100644
index 0000000..bcd5026
--- /dev/null
+++ b/src/libcharon/tests/suites/test_expandrule_hash.c
@@ -0,0 +1,223 @@
+/*
+ * Copyright (C) 2026 Zhuoyuan Hao
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation; either version 2 of the License, or (at your
+ * option) any later version.  See <http://www.fsf.org/copyleft/gpl.txt>.
+ */
+
+#include "test_suite.h"
+#include "expandrule_test_fixtures.h"
+#include "expandrule_hash_test_helpers.h"
+#include "../utils/mock_dh.h"
+
+#include <credentials/keys/shared_key.h>
+#include <crypto/proposal/proposal.h>
+#include <encoding/payloads/expandrule_payload.h>
+#include <encoding/payloads/nonce_payload.h>
+#include <encoding/payloads/notify_payload.h>
+#include <networking/host.h>
+#include <sa/ikev1/keymat_v1.h>
+#include <sa/ikev1/tasks/expandrule.h>
+
+keymat_v1_t *expandrule_test_create_keymat(bool initiator)
+{
+	chunk_t dh_other = chunk_from_chars(
+		0x01,0x02,0x03,0x04,0x05,0x06,0x07,0x08,
+		0x01,0x02,0x03,0x04,0x05,0x06,0x07,0x08,
+		0x01,0x02,0x03,0x04,0x05,0x06,0x07,0x08,
+		0x01,0x02,0x03,0x04,0x05,0x06,0x07,0x08);
+	chunk_t nonce_i = chunk_from_chars(
+		0x10,0x11,0x12,0x13,0x14,0x15,0x16,0x17,
+		0x18,0x19,0x1a,0x1b,0x1c,0x1d,0x1e,0x1f);
+	chunk_t nonce_r = chunk_from_chars(
+		0x20,0x21,0x22,0x23,0x24,0x25,0x26,0x27,
+		0x28,0x29,0x2a,0x2b,0x2c,0x2d,0x2e,0x2f);
+	key_exchange_t *dh = mock_dh_create(MODP_1024_BIT);
+	proposal_t *proposal = proposal_create_from_string(PROTO_IKE,
+												 "aes128-sha1-modp1024");
+	shared_key_t *shared = shared_key_create(SHARED_IKE,
+										 chunk_clone(chunk_from_str("test-psk")));
+	ike_sa_id_t *id = ike_sa_id_create(IKEV1_MAJOR_VERSION,
+									 0x0102030405060708,
+									 0x1112131415161718, initiator);
+	keymat_v1_t *keymat = keymat_v1_create(initiator);
+
+	ck_assert(proposal);
+	ck_assert(keymat->derive_ike_keys(keymat, proposal, dh, dh_other,
+									 nonce_i, nonce_r, id, AUTH_PSK, shared));
+	id->destroy(id);
+	shared->destroy(shared);
+	proposal->destroy(proposal);
+	dh->destroy(dh);
+	return keymat;
+}
+
+expandrule_payload_t *expandrule_test_create_add_payload_from(chunk_t wire)
+{
+	return expandrule_payload_create_data(PLV1_EXPANDRULE_ADD, wire.ptr[1],
+						chunk_clone(chunk_create(wire.ptr + 4, wire.len - 4)));
+}
+
+expandrule_payload_t *expandrule_test_create_add_payload(void)
+{
+	return expandrule_test_create_add_payload_from(
+		expandrule_fixture(expandrule_empty_v4_bytes,
+											 sizeof(expandrule_empty_v4_bytes)));
+}
+
+message_t *expandrule_test_create_phase2(exchange_type_t exchange, uint32_t mid)
+{
+	message_t *message = message_create(IKEV1_MAJOR_VERSION,
+									IKEV1_MINOR_VERSION);
+
+	message->set_exchange_type(message, exchange);
+	message->set_message_id(message, mid);
+	return message;
+}
+
+void expandrule_test_add_nonce(message_t *message, chunk_t value)
+{
+	nonce_payload_t *nonce = nonce_payload_create(PLV1_NONCE);
+
+	nonce->set_nonce(nonce, value);
+	message->add_payload(message, &nonce->payload_interface);
+}
+
+static void prime_quick_mode_with(keymat_v1_t *keymat, uint32_t mid,
+								  chunk_t n_i, chunk_t n_r)
+{
+	message_t *message;
+	chunk_t hash;
+
+	message = expandrule_test_create_phase2(QUICK_MODE, mid);
+	expandrule_test_add_nonce(message, n_i);
+	ck_assert(keymat->get_hash_phase2(keymat, message, &hash));
+	chunk_free(&hash);
+	message->destroy(message);
+
+	message = expandrule_test_create_phase2(QUICK_MODE, mid);
+	message->set_request(message, FALSE);
+	expandrule_test_add_nonce(message, n_r);
+	ck_assert(keymat->get_hash_phase2(keymat, message, &hash));
+	chunk_free(&hash);
+	message->destroy(message);
+}
+
+static void prime_quick_mode(keymat_v1_t *keymat, uint32_t mid)
+{
+	prime_quick_mode_with(keymat, mid,
+		chunk_from_chars(
+			0x10,0x11,0x12,0x13,0x14,0x15,0x16,0x17,
+			0x18,0x19,0x1a,0x1b,0x1c,0x1d,0x1e,0x1f),
+		chunk_from_chars(
+			0x20,0x21,0x22,0x23,0x24,0x25,0x26,0x27,
+			0x28,0x29,0x2a,0x2b,0x2c,0x2d,0x2e,0x2f));
+}
+
+START_TEST(test_augmented_quick_mode_uses_stock_hash3_reference)
+{
+	chunk_t expected = chunk_from_chars(
+		0x5a,0xc5,0xeb,0x05,0x2d,0xd4,0x04,0x34,0x37,0xfa,
+		0xea,0x7b,0xfb,0x73,0xab,0x30,0x65,0x67,0xe5,0xa6);
+	chunk_t fixtures[] = {
+		expandrule_fixture(expandrule_empty_v4_bytes,
+						   sizeof(expandrule_empty_v4_bytes)),
+		expandrule_fixture(expandrule_v4_d0_bytes,
+						   sizeof(expandrule_v4_d0_bytes)),
+	};
+	size_t i;
+
+	for (i = 0; i < countof(fixtures); i++)
+	{
+		keymat_v1_t *keymat = expandrule_test_create_keymat(TRUE);
+		message_t *final = expandrule_test_create_phase2(QUICK_MODE, 0x10203040);
+		chunk_t hash;
+
+		prime_quick_mode(keymat, 0x10203040);
+		final->add_payload(final,
+			&expandrule_test_create_add_payload_from(fixtures[i])->payload_interface);
+		ck_assert(keymat->get_hash_phase2(keymat, final, &hash));
+		ck_assert_msg(chunk_equals(hash, expected),
+					  "stock HASH(3) %B != reference %B", &hash, &expected);
+		chunk_free(&hash);
+		final->destroy(final);
+		keymat->keymat.destroy(&keymat->keymat);
+	}
+	{
+		keymat_v1_t *keymat = expandrule_test_create_keymat(TRUE);
+		message_t *final = expandrule_test_create_phase2(QUICK_MODE, 0x10203040);
+		chunk_t hash;
+
+		prime_quick_mode_with(keymat, 0x10203040,
+			chunk_from_chars(
+				0x10,0x11,0x12,0x13,0x14,0x15,0x16,0x17,
+				0x18,0x19,0x1a,0x1b,0x1c,0x1d,0x1e,0x1f),
+			chunk_from_chars(
+				0x20,0x21,0x22,0x23,0x24,0x25,0x26,0x27,
+				0x28,0x29,0x2a,0x2b,0x2c,0x2d,0x2e,0x30));
+		final->add_payload(final,
+			&expandrule_test_create_add_payload()->payload_interface);
+		ck_assert(keymat->get_hash_phase2(keymat, final, &hash));
+		ck_assert_msg(!chunk_equals(hash, expected),
+					  "HASH(3) did not bind the responder nonce");
+		chunk_free(&hash);
+		final->destroy(final);
+		keymat->keymat.destroy(&keymat->keymat);
+	}
+}
+END_TEST
+
+START_TEST(test_synthetic_augmented_qm_roundtrip_has_hash_then_addrule)
+{
+	keymat_v1_t *initiator = expandrule_test_create_keymat(TRUE);
+	keymat_v1_t *responder = expandrule_test_create_keymat(FALSE);
+	ike_sa_id_t *id = ike_sa_id_create(IKEV1_MAJOR_VERSION,
+									 0x0102030405060708,
+									 0x1112131415161718, TRUE);
+	message_t *message, *parsed;
+	packet_t *packet;
+	enumerator_t *enumerator;
+	payload_t *payload;
+	payload_type_t expected[] = { PLV1_HASH, PLV1_EXPANDRULE_ADD };
+	size_t count = 0;
+
+	prime_quick_mode(initiator, 0x50607080);
+	prime_quick_mode(responder, 0x50607080);
+	message = expandrule_test_create_phase2(QUICK_MODE, 0x50607080);
+	message->set_ike_sa_id(message, id);
+	message->set_source(message, host_create_from_string("192.0.2.1", 500));
+	message->set_destination(message, host_create_from_string("192.0.2.2", 500));
+	message->add_payload(message,
+						 &expandrule_test_create_add_payload()->payload_interface);
+	ck_assert_int_eq(message->generate(message, &initiator->keymat, &packet),
+					 SUCCESS);
+	ck_assert_int_eq(packet->get_data(packet).ptr[16], PLV1_HASH);
+
+	parsed = message_create_from_packet(packet);
+	ck_assert_int_eq(parsed->parse_header(parsed), SUCCESS);
+	ck_assert_int_eq(parsed->parse_body(parsed, &responder->keymat), SUCCESS);
+	enumerator = parsed->create_payload_enumerator(parsed);
+	while (enumerator->enumerate(enumerator, &payload))
+	{
+		ck_assert(count < countof(expected));
+		ck_assert_int_eq(payload->get_type(payload), expected[count]);
+		count++;
+	}
+	enumerator->destroy(enumerator);
+	ck_assert_int_eq(count, countof(expected));
+
+	parsed->destroy(parsed);
+	message->destroy(message);
+	id->destroy(id);
+	initiator->keymat.destroy(&initiator->keymat);
+	responder->keymat.destroy(&responder->keymat);
+}
+END_TEST
+
+void expandrule_add_hash_tests(TCase *tc)
+{
+	tcase_add_test(tc, test_augmented_quick_mode_uses_stock_hash3_reference);
+	tcase_add_test(tc, test_synthetic_augmented_qm_roundtrip_has_hash_then_addrule);
+}
