+
+#include "test_suite.h"
+#include "expandrule_hash_test_helpers.h"
+
+#include <encoding/payloads/notify_payload.h>
+#include <networking/host.h>
+
+START_TEST(test_custom_quick_mode_mixed_or_wrong_type_rejected)
+{
+	keymat_v1_t *keymat = expandrule_test_create_keymat(TRUE);
+	message_t *message;
+	expandrule_payload_t *payload;
+	chunk_t nonce = chunk_from_chars(
+		0x30,0x31,0x32,0x33,0x34,0x35,0x36,0x37);
+
+	message = expandrule_test_create_phase2(QUICK_MODE, 0x20304050);
+	message->set_source(message, host_create_from_string("192.0.2.1", 500));
+	message->set_destination(message, host_create_from_string("192.0.2.2", 500));
+	message->add_payload(message,
+						 &expandrule_test_create_add_payload()->payload_interface);
+	ck_assert_int_eq(message->generate(message, &keymat->keymat, NULL),
+					 VERIFY_ERROR);
+	message->destroy(message);
+
+	message = expandrule_test_create_phase2(QUICK_MODE, 0x20304051);
+	message->set_source(message, host_create_from_string("192.0.2.1", 500));
+	message->set_destination(message, host_create_from_string("192.0.2.2", 500));
+	message->add_payload(message,
+						 &expandrule_test_create_add_payload()->payload_interface);
+	expandrule_test_add_nonce(message, nonce);
+	ck_assert_int_eq(message->generate(message, &keymat->keymat, NULL),
+					 VERIFY_ERROR);
+	message->destroy(message);
+
+	message = expandrule_test_create_phase2(QUICK_MODE, 0x20304052);
+	message->set_source(message, host_create_from_string("192.0.2.1", 500));
+	message->set_destination(message, host_create_from_string("192.0.2.2", 500));
+	expandrule_test_add_nonce(message, nonce);
+	message->add_payload(message,
+						 &expandrule_test_create_add_payload()->payload_interface);
+	ck_assert_int_eq(message->generate(message, &keymat->keymat, NULL),
+					 VERIFY_ERROR);
+	message->destroy(message);
+
+	message = expandrule_test_create_phase2(QUICK_MODE, 0x30405060);
+	message->set_source(message, host_create_from_string("192.0.2.1", 500));
+	message->set_destination(message, host_create_from_string("192.0.2.2", 500));
+	payload = expandrule_payload_create_data(PLV1_EXPANDRULE_DELETE, 0,
+										 chunk_clone(chunk_from_chars(0x01)));
+	message->add_payload(message, &payload->payload_interface);
+	ck_assert_int_eq(message->generate(message, &keymat->keymat, NULL),
+					 VERIFY_ERROR);
+	message->destroy(message);
+
+	message = expandrule_test_create_phase2(QUICK_MODE, 0x30405061);
+	message->set_request(message, FALSE);
+	message->set_source(message, host_create_from_string("192.0.2.1", 500));
+	message->set_destination(message, host_create_from_string("192.0.2.2", 500));
+	message->add_payload(message,
+						 &expandrule_test_create_add_payload()->payload_interface);
+	ck_assert_int_eq(message->generate(message, &keymat->keymat, NULL),
+					 VERIFY_ERROR);
+	message->destroy(message);
+	keymat->keymat.destroy(&keymat->keymat);
+}
+END_TEST
+
+START_TEST(test_informational_custom_types_are_mutually_exclusive)
+{
+	keymat_v1_t *keymat = expandrule_test_create_keymat(TRUE);
+	message_t *message = expandrule_test_create_phase2(
+										INFORMATIONAL_V1, 0x40506070);
+	expandrule_payload_t *payload;
+
+	message->set_source(message, host_create_from_string("192.0.2.1", 500));
+	message->set_destination(message, host_create_from_string("192.0.2.2", 500));
+	message->add_payload(message,
+						 &expandrule_test_create_add_payload()->payload_interface);
+	payload = expandrule_payload_create_data(PLV1_EXPANDRULE_DELETE, 0,
+										 chunk_clone(chunk_from_chars(0x01)));
+	message->add_payload(message, &payload->payload_interface);
+	ck_assert_int_eq(message->generate(message, &keymat->keymat, NULL),
+					 VERIFY_ERROR);
+	message->destroy(message);
+
+	message = expandrule_test_create_phase2(INFORMATIONAL_V1, 0x40506071);
+	message->set_source(message, host_create_from_string("192.0.2.1", 500));
+	message->set_destination(message, host_create_from_string("192.0.2.2", 500));
+	message->add_payload(message,
+						 &expandrule_test_create_add_payload()->payload_interface);
+	message->add_payload(message,
+						 &notify_payload_create(PLV1_NOTIFY)->payload_interface);
+	ck_assert_int_eq(message->generate(message, &keymat->keymat, NULL),
+					 VERIFY_ERROR);
+	message->destroy(message);
+
+	message = expandrule_test_create_phase2(INFORMATIONAL_V1, 0x40506072);
+	message->set_source(message, host_create_from_string("192.0.2.1", 500));
+	message->set_destination(message, host_create_from_string("192.0.2.2", 500));
+	payload = expandrule_payload_create_data(PLV1_EXPANDRULE_LEGACY_REVOKE, 0,
+										 chunk_clone(chunk_from_chars(0x01,0x41)));
+	message->add_payload(message, &payload->payload_interface);
+	ck_assert_int_eq(message->generate(message, &keymat->keymat, NULL),
+					 VERIFY_ERROR);
+	message->destroy(message);
+	keymat->keymat.destroy(&keymat->keymat);
+}
+END_TEST
+
+void expandrule_add_message_context_tests(TCase *tc)
+{
+	tcase_add_test(tc, test_custom_quick_mode_mixed_or_wrong_type_rejected);
+	tcase_add_test(tc, test_informational_custom_types_are_mutually_exclusive);
+}
diff --git a/src/libcharon/tests/suites/test_expandrule_task.c b/src/libcharon/tests/suites/test_expandrule_task.c
new file mode 100644
index 0000000..c2a1902
--- /dev/null
+++ b/src/libcharon/tests/suites/test_expandrule_task.c
@@ -0,0 +1,288 @@
+/*
+ * Copyright (C) 2026 Zhuoyuan Hao
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation; either version 2 of the License, or (at your
+ * option) any later version.  See <http://www.fsf.org/copyleft/gpl.txt>.
+ */
+
+#include "test_suite.h"
+#include "expandrule_test_fixtures.h"
+
+#include <encoding/generator.h>
+#include <encoding/payloads/expandrule_payload.h>
+#include <encoding/payloads/hash_payload.h>
+#include <encoding/payloads/nonce_payload.h>
+#include <sa/ikev1/tasks/expandrule.h>
+
+static message_t *create_message(expandrule_wire_form_t form)
+{
+	message_t *message = message_create(IKEV1_MAJOR_VERSION, IKEV1_MINOR_VERSION);
+	message->set_exchange_type(message, form == EXPANDRULE_QM_ADD_SNAPSHOT ?
+									 QUICK_MODE : INFORMATIONAL_V1);
+	return message;
+}
+
+static void add_standard_qm_payloads(message_t *message)
+{
+	payload_t *sa = payload_create(PLV1_SECURITY_ASSOCIATION);
+	nonce_payload_t *nonce = nonce_payload_create(PLV1_NONCE);
+	ck_assert(sa);
+	nonce->set_nonce(nonce, chunk_from_chars(
+		0x10,0x11,0x12,0x13,0x14,0x15,0x16,0x17));
+	message->add_payload(message, sa);
+	message->add_payload(message, &nonce->payload_interface);
+}
+
+static void add_synthetic_hash(message_t *message)
+{
+	hash_payload_t *hash = hash_payload_create(PLV1_HASH);
+	hash->set_hash(hash, chunk_from_chars(0x00));
+	message->add_payload(message, &hash->payload_interface);
+}
+
+static expandrule_payload_t *payload_from_fixture(payload_type_t type,
+											  chunk_t fixture)
+{
+	return expandrule_payload_create_data(type, fixture.ptr[1],
+					chunk_clone(chunk_create(fixture.ptr + 4, fixture.len - 4)));
+}
+
+START_TEST(test_task_build_and_explicit_context)
+{
+	expandrule_message_t model = {
+		.kind = EXPANDRULE_CLIENT_ENVELOPE,
+		.data.client = {
+			.family = EXPANDRULE_IPV4,
+			.dialect = EXPANDRULE_DIALECT_0,
+			.leading_address = chunk_from_chars(0xc0,0x00,0x02,0x0a),
+		},
+	};
+	expandrule_t *task;
+	expandrule_error_t error;
+	expandrule_payload_t *payload;
+	message_t *message, *response, *final;
+	generator_t *generator;
+	chunk_t encoded, expected = expandrule_fixture(expandrule_empty_v4_bytes,
+												 sizeof(expandrule_empty_v4_bytes));
+
+	task = expandrule_create(EXPANDRULE_QM_ADD_SNAPSHOT, EXPANDRULE_DIALECT_0);
+	ck_assert(task->set_message(task, &model, &error));
+	message = create_message(EXPANDRULE_QM_ADD_SNAPSHOT);
+	message->set_message_id(message, 0x10203040);
+	ck_assert_int_eq(task->task.build(&task->task, message), FAILED);
+	message->destroy(message);
+	task->task.destroy(&task->task);
+
+	task = expandrule_create(EXPANDRULE_QM_ADD_SNAPSHOT, EXPANDRULE_DIALECT_0);
+	ck_assert_int_eq(task->task.get_type(&task->task), TASK_EXPANDRULE);
+	ck_assert(task->set_message(task, &model, &error));
+	message = create_message(EXPANDRULE_QM_ADD_SNAPSHOT);
+	message->set_message_id(message, 0x10203040);
+	add_standard_qm_payloads(message);
+	ck_assert_int_eq(task->task.build(&task->task, message), NEED_MORE);
+	ck_assert(!message->get_payload(message, PLV1_EXPANDRULE_ADD));
+	response = create_message(EXPANDRULE_QM_ADD_SNAPSHOT);
+	response->set_request(response, FALSE);
+	response->set_message_id(response, 0x10203040);
+	add_standard_qm_payloads(response);
+	ck_assert_int_eq(task->task.process(&task->task, response), NEED_MORE);
+	ck_assert(!task->get_message(task));
+	final = create_message(EXPANDRULE_QM_ADD_SNAPSHOT);
+	final->set_message_id(final, 0x10203040);
+	ck_assert_int_eq(task->task.build(&task->task, final), SUCCESS);
+	payload = (expandrule_payload_t*)final->get_payload(final,
+												 PLV1_EXPANDRULE_ADD);
+	ck_assert(payload);
+	generator = generator_create_no_dbg();
+	generator->generate_payload(generator, &payload->payload_interface);
+	encoded = generator->get_chunk(generator, NULL);
+	ck_assert(chunk_equals(encoded, expected));
+	generator->destroy(generator);
+	message->destroy(message);
+	response->destroy(response);
+	final->destroy(final);
+	task->task.destroy(&task->task);
+
+	task = expandrule_create(EXPANDRULE_QM_ADD_SNAPSHOT, EXPANDRULE_DIALECT_1);
+	ck_assert(!task->set_message(task, &model, &error));
+	ck_assert_int_eq(error.code, EXPANDRULE_ERROR_UNSUPPORTED_CONTEXT);
+	task->task.destroy(&task->task);
+}
+END_TEST
+
+START_TEST(test_task_builds_only_client_informational_forms)
+{
+	expandrule_wire_form_t forms[] = {
+		EXPANDRULE_INFO_ADD_DELTA,
+		EXPANDRULE_INFO_DELETE_DELTA,
+	};
+	payload_type_t types[] = {
+		PLV1_EXPANDRULE_ADD,
+		PLV1_EXPANDRULE_DELETE,
+	};
+	chunk_t fixture = expandrule_fixture(expandrule_single_delta_bytes,
+										 sizeof(expandrule_single_delta_bytes));
+	expandrule_message_t *model;
+	expandrule_error_t error;
+	expandrule_t *task;
+	message_t *message;
+	size_t i;
+
+	for (i = 0; i < countof(forms); i++)
+	{
+		ck_assert(expandrule_codec_decode(forms[i], EXPANDRULE_DIALECT_0,
+									  fixture, &model, &error));
+		task = expandrule_create(forms[i], EXPANDRULE_DIALECT_0);
+		ck_assert(task->set_message(task, model, &error));
+		message = create_message(forms[i]);
+		ck_assert_int_eq(task->task.build(&task->task, message), SUCCESS);
+		ck_assert(message->get_payload(message, types[i]));
+		message->destroy(message);
+		task->task.destroy(&task->task);
+		expandrule_message_destroy(model);
+	}
+}
+END_TEST
+
+START_TEST(test_task_process_all_forms)
+{
+	struct {
+		expandrule_wire_form_t form;
+		expandrule_dialect_t dialect;
+		payload_type_t type;
+		chunk_t fixture;
+	} cases[] = {
+		{ EXPANDRULE_QM_ADD_SNAPSHOT, EXPANDRULE_DIALECT_0,
+		  PLV1_EXPANDRULE_ADD, expandrule_fixture(expandrule_empty_v4_bytes,
+												  sizeof(expandrule_empty_v4_bytes)) },
+		{ EXPANDRULE_INFO_ADD_DELTA, EXPANDRULE_DIALECT_0,
+		  PLV1_EXPANDRULE_ADD, expandrule_fixture(expandrule_single_delta_bytes,
+												  sizeof(expandrule_single_delta_bytes)) },
+		{ EXPANDRULE_INFO_DELETE_DELTA, EXPANDRULE_DIALECT_0,
+		  PLV1_EXPANDRULE_DELETE, expandrule_fixture(expandrule_single_delta_bytes,
+												 sizeof(expandrule_single_delta_bytes)) },
+		{ EXPANDRULE_INFO_REVOKE_V1, EXPANDRULE_DIALECT_NONE,
+		  PLV1_EXPANDRULE_DELETE, expandrule_fixture(expandrule_revoke_bytes,
+											 sizeof(expandrule_revoke_bytes)) },
+		{ EXPANDRULE_INFO_REVOKE_LEGACY, EXPANDRULE_DIALECT_NONE,
+		  PLV1_EXPANDRULE_LEGACY_REVOKE, expandrule_fixture(expandrule_revoke_bytes,
+													 sizeof(expandrule_revoke_bytes)) },
+	};
+	message_t *message;
+	expandrule_payload_t *payload;
+	expandrule_t *task;
+	size_t i;
+
+	for (i = 0; i < countof(cases); i++)
+	{
+		message = create_message(cases[i].form);
+		if (expandrule_form_direction(cases[i].form) ==
+			EXPANDRULE_SERVER_TO_CLIENT)
+		{
+			add_synthetic_hash(message);
+		}
+		payload = payload_from_fixture(cases[i].type, cases[i].fixture);
+		message->add_payload(message, &payload->payload_interface);
+		task = expandrule_create(cases[i].form, cases[i].dialect);
+		if (expandrule_form_direction(cases[i].form) ==
+			EXPANDRULE_SERVER_TO_CLIENT)
+		{
+			ck_assert_int_eq(task->task.process(&task->task, message), SUCCESS);
+			ck_assert(task->get_message(task));
+		}
+		else
+		{
+			ck_assert_int_eq(task->task.process(&task->task, message), FAILED);
+			ck_assert(!task->get_message(task));
+		}
+		task->task.destroy(&task->task);
+		message->destroy(message);
+	}
+}
+END_TEST
+
+START_TEST(test_task_actor_order_and_migration_gates)
+{
+	expandrule_message_t client = {
+		.kind = EXPANDRULE_CLIENT_ENVELOPE,
+		.data.client = {
+			.family = EXPANDRULE_IPV4,
+			.dialect = EXPANDRULE_DIALECT_0,
+			.leading_address = chunk_from_chars(0xc0,0x00,0x02,0x0a),
+		},
+	};
+	expandrule_message_t revoke = {
+		.kind = EXPANDRULE_SERVER_REVOKE,
+		.data.revoke = { .raw_flags = 0,
+						 .opaque_value = chunk_from_chars(0x41) },
+	};
+	expandrule_t *task;
+	expandrule_error_t error;
+	expandrule_payload_t *payload;
+	message_t *message;
+
+	task = expandrule_create(EXPANDRULE_INFO_REVOKE_V1,
+							 EXPANDRULE_DIALECT_NONE);
+	ck_assert(!task->set_message(task, &revoke, &error));
+	message = create_message(EXPANDRULE_INFO_REVOKE_V1);
+	ck_assert_int_eq(task->task.build(&task->task, message), FAILED);
+	message->destroy(message);
+	task->task.destroy(&task->task);
+
+	task = expandrule_create(EXPANDRULE_INFO_REVOKE_LEGACY,
+							 EXPANDRULE_DIALECT_NONE);
+	message = create_message(EXPANDRULE_INFO_REVOKE_LEGACY);
+	payload = payload_from_fixture(PLV1_EXPANDRULE_LEGACY_REVOKE,
+		expandrule_fixture(expandrule_revoke_bytes,
+						   sizeof(expandrule_revoke_bytes)));
+	message->add_payload(message, &payload->payload_interface);
+	add_synthetic_hash(message);
+	ck_assert_int_eq(task->task.process(&task->task, message), FAILED);
+	message->destroy(message);
+	task->task.destroy(&task->task);
+
+	task = expandrule_create(EXPANDRULE_QM_ADD_SNAPSHOT, EXPANDRULE_DIALECT_0);
+	ck_assert(task->set_message(task, &client, &error));
+	task->task.migrate(&task->task, NULL);
+	message = create_message(EXPANDRULE_QM_ADD_SNAPSHOT);
+	add_standard_qm_payloads(message);
+	ck_assert_int_eq(task->task.build(&task->task, message), FAILED);
+	message->destroy(message);
+	task->task.destroy(&task->task);
+}
+END_TEST
+
+START_TEST(test_task_rejects_invalid_profile_and_form)
+{
+	uint8_t invalid[] = { 0x00,0x00,0x00,0x04 };
+	message_t *message = create_message(EXPANDRULE_INFO_REVOKE_V1);
+	expandrule_payload_t *payload;
+	expandrule_t *task;
+
+	ck_assert(!expandrule_create(EXPANDRULE_QM_ADD_SNAPSHOT,
+									 EXPANDRULE_DIALECT_NONE));
+	ck_assert(!expandrule_create(EXPANDRULE_INFO_REVOKE_V1,
+									 EXPANDRULE_DIALECT_0));
+	add_synthetic_hash(message);
+	payload = payload_from_fixture(PLV1_EXPANDRULE_DELETE,
+									chunk_from_thing(invalid));
+	message->add_payload(message, &payload->payload_interface);
+	task = expandrule_create(EXPANDRULE_INFO_REVOKE_V1,
+							 EXPANDRULE_DIALECT_NONE);
+	ck_assert_int_eq(task->task.process(&task->task, message), FAILED);
+	ck_assert(task->get_error(task).code != EXPANDRULE_ERROR_NONE);
+	task->task.destroy(&task->task);
+	message->destroy(message);
+}
+END_TEST
+
+void expandrule_add_task_tests(TCase *tc)
+{
+	tcase_add_test(tc, test_task_build_and_explicit_context);
+	tcase_add_test(tc, test_task_builds_only_client_informational_forms);
+	tcase_add_test(tc, test_task_process_all_forms);
+	tcase_add_test(tc, test_task_actor_order_and_migration_gates);
+	tcase_add_test(tc, test_task_rejects_invalid_profile_and_form);
+}
