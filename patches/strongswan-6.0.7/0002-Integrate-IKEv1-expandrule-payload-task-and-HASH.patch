+/**
+ * @defgroup expandrule_payload expandrule_payload
+ * @{ @ingroup payloads
+ */
+
+#ifndef EXPANDRULE_PAYLOAD_H_
+#define EXPANDRULE_PAYLOAD_H_
+
+typedef struct expandrule_payload_t expandrule_payload_t;
+
+#include <library.h>
+#include <encoding/payloads/payload.h>
+
+/**
+ * Generic IKEv1 frame for private expandrule payload types 17, 18 and 19.
+ *
+ * Unlike the standard generic IKE header, the second octet is an opaque raw
+ * byte.  In particular, it must not be represented as a critical flag plus
+ * reserved bits.  Body interpretation remains in expandrule_codec.
+ */
+struct expandrule_payload_t {
+
+	/** Implements payload_t. */
+	payload_t payload_interface;
+
+	/** Return the uninterpreted second header octet. */
+	uint8_t (*get_raw_flags)(expandrule_payload_t *this);
+
+	/**
+	 * Return the body bytes after the four-byte generic header.
+	 *
+	 * The returned chunk is borrowed and must not be freed or modified.
+	 */
+	chunk_t (*get_data)(expandrule_payload_t *this);
+
+	/** Destroy this payload. */
+	void (*destroy)(expandrule_payload_t *this);
+};
+
+/**
+ * Create an empty payload for parsing.
+ *
+ * @param type	one of the three PLV1_EXPANDRULE_* types
+ * @return		payload instance, or NULL for any other type
+ */
+expandrule_payload_t *expandrule_payload_create(payload_type_t type);
+
+/**
+ * Create a payload for generation.
+ *
+ * @param type		one of the three PLV1_EXPANDRULE_* types
+ * @param raw_flags	uninterpreted second header octet
+ * @param data		body bytes, adopted by the payload
+ * @return			payload instance, or NULL for any other type
+ */
+expandrule_payload_t *expandrule_payload_create_data(payload_type_t type,
+										 uint8_t raw_flags, chunk_t data);
+
+#endif /** EXPANDRULE_PAYLOAD_H_ @}*/
