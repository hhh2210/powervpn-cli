+#include "test_suite.h"
+
+#include <encoding/generator.h>
+#include <encoding/message.h>
+#include <encoding/parser.h>
+#include <encoding/payloads/expandrule_payload.h>
+
+START_TEST(test_raw_flags_frame_roundtrip)
+{
+	expandrule_payload_t *payload, *decoded;
+	generator_t *generator;
+	parser_t *parser;
+	payload_t *parsed;
+	chunk_t wire, expected = chunk_from_chars(0x00,0xa5,0x00,0x07,
+										  0x01,0x02,0x03);
+
+	payload = expandrule_payload_create_data(PLV1_EXPANDRULE_ADD, 0xa5,
+										 chunk_clone(chunk_from_chars(0x01,0x02,0x03)));
+	ck_assert(payload);
+	generator = generator_create_no_dbg();
+	generator->generate_payload(generator, &payload->payload_interface);
+	wire = generator->get_chunk(generator, NULL);
+	ck_assert_msg(chunk_equals(wire, expected), "raw flag byte was rewritten");
+	parser = parser_create(wire);
+	parser->set_major_version(parser, IKEV1_MAJOR_VERSION);
+	ck_assert_int_eq(parser->parse_payload(parser, PLV1_EXPANDRULE_ADD, &parsed),
+					 SUCCESS);
+	ck_assert_int_eq(parsed->verify(parsed), SUCCESS);
+	decoded = (expandrule_payload_t*)parsed;
+	ck_assert_int_eq(decoded->get_raw_flags(decoded), 0xa5);
+	ck_assert(chunk_equals(decoded->get_data(decoded),
+						  chunk_from_chars(0x01,0x02,0x03)));
+	parsed->destroy(parsed);
+	parser->destroy(parser);
+	generator->destroy(generator);
+	payload->destroy(payload);
+}
+END_TEST
+
+START_TEST(test_payload_factory_is_ikev1_only)
+{
+	payload_type_t types[] = {
+		PLV1_EXPANDRULE_LEGACY_REVOKE,
+		PLV1_EXPANDRULE_ADD,
+		PLV1_EXPANDRULE_DELETE,
+	};
+	payload_t *payload;
+	size_t i;
+
+	for (i = 0; i < countof(types); i++)
+	{
+		ck_assert(payload_is_known(types[i], IKEV1_MAJOR_VERSION));
+		ck_assert(!payload_is_known(types[i], IKEV2_MAJOR_VERSION));
+		payload = payload_create(types[i]);
+		ck_assert(payload);
+		ck_assert_int_eq(payload->get_type(payload), types[i]);
+		payload->destroy(payload);
+	}
+	ck_assert(!expandrule_payload_create(PLV1_NOTIFY));
+}
+END_TEST
+
+void expandrule_add_integration_tests(TCase *tc)
+{
+	tcase_add_test(tc, test_raw_flags_frame_roundtrip);
+	tcase_add_test(tc, test_payload_factory_is_ikev1_only);
+}
