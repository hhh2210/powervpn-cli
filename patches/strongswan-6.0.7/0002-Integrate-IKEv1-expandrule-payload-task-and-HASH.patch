+
+#include <stddef.h>
+
+#include "expandrule_payload.h"
+
+typedef struct private_expandrule_payload_t private_expandrule_payload_t;
+
+/** Private generic-frame state. */
+struct private_expandrule_payload_t {
+	expandrule_payload_t public;
+	payload_type_t type;
+	uint8_t next_payload;
+	uint8_t raw_flags;
+	uint16_t payload_length;
+	chunk_t data;
+};
+
+/**
+ * Keep the complete second octet intact.  CHUNK_DATA is symbolic because its
+ * numeric encoding-rule value is not stable across strongSwan releases.
+ */
+static encoding_rule_t encodings[] = {
+	{ U_INT_8,          offsetof(private_expandrule_payload_t, next_payload) },
+	{ U_INT_8,          offsetof(private_expandrule_payload_t, raw_flags) },
+	{ PAYLOAD_LENGTH,   offsetof(private_expandrule_payload_t, payload_length) },
+	{ CHUNK_DATA,       offsetof(private_expandrule_payload_t, data) },
+};
+
+static bool is_expandrule_type(payload_type_t type)
+{
+	return type == PLV1_EXPANDRULE_LEGACY_REVOKE ||
+		   type == PLV1_EXPANDRULE_ADD ||
+		   type == PLV1_EXPANDRULE_DELETE;
+}
+
+METHOD(payload_t, verify, status_t,
+	private_expandrule_payload_t *this)
+{
+	if (!is_expandrule_type(this->type) ||
+		this->payload_length != sizeof(uint32_t) + this->data.len)
+	{
+		return FAILED;
+	}
+	return SUCCESS;
+}
+
+METHOD(payload_t, get_encoding_rules, int,
+	private_expandrule_payload_t *this, encoding_rule_t **rules)
+{
+	*rules = encodings;
+	return countof(encodings);
+}
+
+METHOD(payload_t, get_header_length, int,
+	private_expandrule_payload_t *this)
+{
+	return 4;
+}
+
+METHOD(payload_t, get_type, payload_type_t,
+	private_expandrule_payload_t *this)
+{
+	return this->type;
+}
+
+METHOD(payload_t, get_next_type, payload_type_t,
+	private_expandrule_payload_t *this)
+{
+	return this->next_payload;
+}
+
+METHOD(payload_t, set_next_type, void,
+	private_expandrule_payload_t *this, payload_type_t type)
+{
+	this->next_payload = type;
+}
+
+METHOD(payload_t, get_length, size_t,
+	private_expandrule_payload_t *this)
+{
+	return this->payload_length;
+}
+
+METHOD(expandrule_payload_t, get_raw_flags, uint8_t,
+	private_expandrule_payload_t *this)
+{
+	return this->raw_flags;
+}
+
+METHOD(expandrule_payload_t, get_data, chunk_t,
+	private_expandrule_payload_t *this)
+{
+	return this->data;
+}
+
+METHOD2(payload_t, expandrule_payload_t, destroy, void,
+	private_expandrule_payload_t *this)
+{
+	chunk_free(&this->data);
+	free(this);
+}
+
+expandrule_payload_t *expandrule_payload_create(payload_type_t type)
+{
+	private_expandrule_payload_t *this;
+
+	if (!is_expandrule_type(type))
+	{
+		return NULL;
+	}
+	INIT(this,
+		.public = {
+			.payload_interface = {
+				.verify = _verify,
+				.get_encoding_rules = _get_encoding_rules,
+				.get_header_length = _get_header_length,
+				.get_type = _get_type,
+				.get_next_type = _get_next_type,
+				.set_next_type = _set_next_type,
+				.get_length = _get_length,
+				.destroy = _destroy,
+			},
+			.get_raw_flags = _get_raw_flags,
+			.get_data = _get_data,
+			.destroy = _destroy,
+		},
+		.type = type,
+		.next_payload = PL_NONE,
+		.payload_length = 4,
+	);
+	return &this->public;
+}
+
+expandrule_payload_t *expandrule_payload_create_data(payload_type_t type,
+										 uint8_t raw_flags, chunk_t data)
+{
+	private_expandrule_payload_t *this;
+
+	if (data.len > UINT16_MAX - 4 || (!data.ptr && data.len))
+	{
+		chunk_free(&data);
+		return NULL;
+	}
+	this = (private_expandrule_payload_t*)expandrule_payload_create(type);
+	if (!this)
+	{
+		chunk_free(&data);
+		return NULL;
+	}
+	this->raw_flags = raw_flags;
+	this->data = data;
+	this->payload_length = 4 + data.len;
+	return &this->public;
+}
